 #include <linux/hrtimer.h>
 #include <linux/ktime.h>
+#include <linux/moduleparam.h>
+
+/*
+ * Mobarchy: track the playback position with the timer instead of AoC's PCM mailbox
+ * interrupts. On Mobarchy those interrupts do not arrive for PCM playback (AoC still
+ * plays), so the position never moves and ALSA gives up after 100 ms (-EIO).
+ */
+static bool pcm_timer = true;
+module_param(pcm_timer, bool, 0644);
+MODULE_PARM_DESC(pcm_timer, "Poll the PCM position with a timer instead of mailbox interrupts");
 
 static bool is_aaudio_mmaped_service(const char *name)
 {
