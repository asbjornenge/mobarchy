 	DPU_EVENT_LOG(DPU_EVT_PLANE_PREPARE_FB, decon->id, new_state);
 
 	/*
+	 * Implicit sync: without an explicit IN_FENCE_FD, wait for the writers of the
+	 * framebuffer (e.g. a GPU still rendering into it), like the standard GEM helper.
+	 * Android always passes explicit fences; Linux compositors often rely on implicit
+	 * ones, and without this the DPU scans out half-rendered frames (tearing).
+	 */
+	if (new_state->fb && !new_state->fence) {
+		int ret = drm_gem_plane_helper_prepare_fb(plane, new_state);
+
+		if (ret)
+			return ret;
+	}
+
