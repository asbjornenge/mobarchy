 #include "goodix_ts_core.h"
+
+#include <linux/moduleparam.h>
+
+/*
+ * Mobarchy: the controller's single-tap gesture while the screen is off reports
+ * KEY_WAKEUP (only that: no touch). Google ships it disabled (Pixel runs tap-to-wake in
+ * AoC). Read at every suspend, so it can be switched at runtime.
+ */
+static bool wake_gesture;
+module_param(wake_gesture, bool, 0644);
+MODULE_PARM_DESC(wake_gesture, "Wake gesture (KEY_WAKEUP) while the screen is off");
+
+static void goodix_ts_report_wakeup(struct goodix_ts_core *cd)
+{
+	struct input_dev *dev = cd->input_dev;
+
+	ts_info("wake gesture");
+	mutex_lock(&dev->mutex);
+	input_report_key(dev, KEY_WAKEUP, 1);
+	input_sync(dev);
+	input_report_key(dev, KEY_WAKEUP, 0);
+	input_sync(dev);
+	mutex_unlock(&dev->mutex);
+}
