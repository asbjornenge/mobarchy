# The Mali GPU is only reachable through the Android blob (libhybris, later). Until
# then Mesa renders in software on exynos-drm's dumb buffers.
MESA_LOADER_DRIVER_OVERRIDE=kms_swrast
GALLIUM_DRIVER=llvmpipe
# GTK: skip the GL renderers (no GPU driver yet) and draw with cairo directly.
GSK_RENDERER=cairo
