# Default: Mesa renders in software (llvmpipe) on exynos-drm's dumb buffers. When the
# GPU driver comes up at boot, mobarchy-gpu.service overrides this in
# /run/mobarchy/session.env (Panthor + Mesa main, ADR 0008).
MESA_LOADER_DRIVER_OVERRIDE=kms_swrast
GALLIUM_DRIVER=llvmpipe
# GTK: draw with cairo (GTK's GL renderers gain little for the bar and keyboard).
GSK_RENDERER=cairo
