#!/usr/bin/env python3
"""comet's adaptations of vendor files for the Android container (android-container's
overlay hook, ADR 0014): writes replacements under $OVERLAY, from the originals under
$ANDROID_ROOT.

Thermal: Pixel's thermal HAL refuses to start when a cooling device in its configuration
doesn't exist. thermal-gpufreq-0 is Mali's own driver's; Mobarchy drives the GPU with
panthor (ADR 0008), whose cooling device is plain devfreq. So the GPU is taken out of the
HAL's skin-temperature control (the VIRTUAL-SKIN-GPU loop and the GPU's share of
VIRTUAL-SKIN-SOC); it stays protected by the kernel's own junction limit (thermal zone G3D),
which the HAL enables. Everything else is Google's configuration as is.

Display: the container doesn't run Pixel's display HAL (hardware composer); Mobarchy drives
the display itself (DRM). Its VINTF declarations (IDisplay) are emptied, so HALs that use it
when there is one see there is none, instead of waiting for it forever (the sensor HAL, for
the light sensor under the panel).

GPU compute: Mali's OpenCL driver (in libGLES_mali.so) needs Mali's own kernel driver
(kbase), and crashes without it; Mobarchy drives the GPU with panthor (ADR 0008). Its ICD
entry names Mesa's OpenCL (rusticl, in the container's /odm/lib64) instead (ADR 0017).
"""
import json
import os
from pathlib import Path

root = Path(os.environ["ANDROID_ROOT"])
overlay = Path(os.environ["OVERLAY"])
GPU_CDEV = "thermal-gpufreq-0"


def drop_gpu(config):
    config["CoolingDevices"] = [c for c in config.get("CoolingDevices", []) if c["Name"] != GPU_CDEV]
    sensors = []
    for s in config.get("Sensors", []):
        binded = s.get("BindedCdevInfo")
        if binded is not None:
            kept = [b for b in binded if b.get("CdevRequest") != GPU_CDEV]
            if not kept and any(b.get("CdevRequest") == GPU_CDEV for b in binded):
                continue            # a loop for the GPU alone (VIRTUAL-SKIN-GPU)
            s["BindedCdevInfo"] = kept
        sensors.append(s)
    config["Sensors"] = sensors
    return config


for original in sorted((root / "vendor/etc").glob("thermal_info_config*.json")):
    text = original.read_text()
    if GPU_CDEV not in text:
        continue
    target = overlay / original.relative_to(root)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(drop_gpu(json.loads(text)), indent=2) + "\n")


EMPTY_MANIFEST = '<manifest version="9.0" type="device"/>\n'
for original in sorted((root / "vendor/etc/vintf/manifest").glob("pixel-display-*.xml")):
    target = overlay / original.relative_to(root)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(EMPTY_MANIFEST)

RUSTICL = "/odm/lib64/libRusticlOpenCL.so"
for original in sorted((root / "vendor/etc/Khronos/OpenCL/vendors").glob("*.icd")):
    target = overlay / original.relative_to(root)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(RUSTICL + "\n")
