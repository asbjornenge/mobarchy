# comet's part of the Android container's init (ADR 0014): the modem (Shannon 5400).
# The service definitions are the vendor's own; this file only imports them and decides
# what starts, and when.

import /vendor/etc/init/cbd.rc
import /vendor/etc/init/rfsd.rc
import /vendor/etc/init/rild_exynos.rc

on post-fs-data
    # The vendor's directories for the radio (from vendor init.zumapro.board.rc).
    chown radio system /sys/devices/platform/cp-tm1/cp_temp
    chown radio system /sys/devices/platform/cpif/dynamic_pcie_spd/tp_threshold
    chown radio system /sys/devices/platform/cpif/dynamic_pcie_spd/tp_hysteresis
    chown radio system /sys/devices/platform/cpif/dynamic_pcie_spd/dynamic_spd_enable
    mkdir /data/vendor 0771 radio system
    mkdir /data/vendor/log 0771 radio system
    mkdir /data/vendor/log/cbd 0771 radio system
    mkdir /data/vendor/log/rfsd 0771 radio system
    mkdir /data/vendor/rild 0771 radio system
    mkdir /data/vendor/dump 0771 radio system
    mkdir /data/vendor/slog 0771 system system
    mkdir /data/vendor/ssrdump 0771 root system
    mkdir /data/vendor/ssrdump/coredump 0771 root system
    mkdir /data/vendor/radio 773 system radio
    mkdir /data/vendor/radio/image 0771 radio system
    mkdir /data/vendor/modem_stat 0771 radio system
    mkdir /mnt/vendor/modem_userdata/replay 0775 radio system

on mobarchy-start
    # rfsd treats an unset efs.clear.action as a factory reset and deletes the modem's NV
    # data (efs). Android keeps this property in /data across boots; here it is set
    # before rfsd starts, every time. "none": nothing to clear.
    setprop persist.vendor.modem.efs.clear.action none
    start RFS-daemon
    start init.shared_modem_platform
    start vendor.modem_ml_svc_sit
    start vendor.google.radioext@1.0
    start cpboot-daemon

# The modem's other AP-side services. The modem talks to them on oem_ipc1/3 (shared modem
# platform) and oem_ipc2 (modem ML); unanswered, it answers rild late (SIT timeouts) and
# rild forces it to restart. As the vendor's init.shared_modem_platform_l.rc and
# vendor.google.modem_ml_svc_sit.rc, with seclabels.
service init.shared_modem_platform /vendor/bin/shared_modem_platform -s
    user radio
    group system
    seclabel u:r:modem_svc_sit:s0

service vendor.modem_ml_svc_sit /vendor/bin/modem_ml_svc_sit -s
    user radio
    group system
    seclabel u:r:modem_ml_svc_sit:s0

# Google's radio extension (vendor.google.radioext): the modem's state for other HALs (the
# camera HAL asks it). As the vendor's vendor.google.radioext@1.0-service.rc, with a seclabel.
service vendor.google.radioext@1.0 /vendor/bin/hw/vendor.google.radioext@1.0-service
    user radio
    group radio system
    seclabel u:r:hal_radioext_default:s0

on post-fs-data
    rm /data/vendor/radio/shared_modem_platform_pid
    mkdir /data/vendor/radio/modem_temp_file 0775 radio system
    mkdir /data/vendor/modem_ml 0770 radio system
    mkdir /data/vendor/radio/freq 0775 radio system

on property:vendor.modem.crash_detected=1
    stop init.shared_modem_platform
    rm /data/vendor/radio/shared_modem_platform_pid
    setprop vendor.modem.crash_detected 0
    start init.shared_modem_platform

# The radio HAL (AIDL android.hardware.radio.*, on /dev/binder), once the modem is up.
on property:vendor.cbd.boot_done=1
    start ril-daemon

# Thermal management: Pixel's thermal HAL with Google's own comet configuration
# (vendor/etc/thermal_info_config*.json): virtual skin temperatures from the board's
# thermistors, and PID control of the cooling devices (CPU and GPU frequency, charging
# current through chg_mdis). It also enables the kernel's own CPU/GPU junction limits
# (thermal zones BIG, MID, LITTLE, G3D, ...), which are off until something turns them on.
# As the vendor's pixel-thermal-symlinks.rc and android.hardware.thermal-service.pixel.rc,
# with seclabels.
service vendor.thermal.symlinks /vendor/bin/thermal_symlinks
    user system
    group system
    oneshot
    disabled
    seclabel u:r:init-thermal-symlinks-sh:s0

service vendor.thermal-hal /vendor/bin/hw/android.hardware.thermal-service.pixel
    user system
    group system
    disabled
    stdio_to_kmsg
    seclabel u:r:hal_thermal_default:s0

on mobarchy-start
    mkdir /dev/thermal 0750 system system
    mkdir /dev/thermal/tz-by-name 0750 system system
    mkdir /dev/thermal/cdev-by-name 0750 system system
    start vendor.thermal.symlinks

on property:vendor.thermal.link_ready=1
    # the trips the HAL moves (from vendor init.comet.rc and init.zumapro.board.rc)
    chown system system /dev/thermal/tz-by-name/charger_therm/trip_point_0_temp
    chown system system /dev/thermal/tz-by-name/charger_therm/trip_point_0_hyst
    chown system system /dev/thermal/tz-by-name/gnss_tcxo_therm/trip_point_0_temp
    chown system system /dev/thermal/tz-by-name/gnss_tcxo_therm/trip_point_0_hyst
    chown system system /dev/thermal/tz-by-name/modem_therm/trip_point_0_temp
    chown system system /dev/thermal/tz-by-name/modem_therm/trip_point_0_hyst
    chown system system /dev/thermal/tz-by-name/rffe_therm/trip_point_0_temp
    chown system system /dev/thermal/tz-by-name/rffe_therm/trip_point_0_hyst
    chown system system /dev/thermal/tz-by-name/soc_therm/trip_point_0_temp
    chown system system /dev/thermal/tz-by-name/soc_therm/trip_point_0_hyst
    chown system system /dev/thermal/tz-by-name/usb_conn_therm/trip_point_0_temp
    chown system system /dev/thermal/tz-by-name/usb_conn_therm/trip_point_0_hyst
    # the cooling devices the HAL drives (vendor init.zumapro.board.rc, without the GPU's)
    chown system system /dev/thermal/cdev-by-name/thermal-cpufreq-0/user_vote
    chown system system /dev/thermal/cdev-by-name/thermal-cpufreq-1/user_vote
    chown system system /dev/thermal/cdev-by-name/thermal-cpufreq-2/user_vote
    chown system system /dev/thermal/cdev-by-name/gxp-cooling/user_vote
    chown system system /dev/thermal/cdev-by-name/tpu_cooling/user_vote
    chown system system /dev/thermal/cdev-by-name/fcc/cur_state
    chown system system /dev/thermal/cdev-by-name/dc_icl/cur_state
    chown system system /dev/thermal/cdev-by-name/wlc_fcc/cur_state
    chown system system /dev/thermal/cdev-by-name/chg_mdis/cur_state
    chown system system /dev/thermal/cdev-by-name/usbc-port/cur_state
    chown system system /dev/thermal/cdev-by-name/thermal-uclamp-0/cur_state
    chown system system /dev/thermal/cdev-by-name/thermal-uclamp-4/cur_state
    chown system system /dev/thermal/cdev-by-name/thermal-uclamp-7/cur_state
    restart vendor.thermal-hal

# The cameras: Pixel's camera HAL (the com.google.pixel.camera.hal APEX), the graphics
# allocator it gets buffers from, and cameraserver (Android's camera service, for native
# clients). As the vendor's and system's rc files, with seclabels.
service vendor.graphics.allocator-default /vendor/bin/hw/android.hardware.graphics.allocator-V2-service
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    stdio_to_kmsg
    seclabel u:r:hal_graphics_allocator_default:s0

service vendor.camera-provider-2-7-google /apex/com.google.pixel.camera.hal/bin/hw/android.hardware.camera.provider@2.7-service-google
    user system
    group system
    capabilities SYS_NICE
    rlimit rtprio 10 10
    rlimit memlock 268435456 268435456
    # OpenCL on the CPU (Mesa's llvmpipe) until panfrost serves it (ADR 0017)
    setenv RUSTICL_ENABLE llvmpipe
    stdio_to_kmsg
    seclabel u:r:hal_camera_default:s0

service cameraserver /system/bin/cameraserver
    user cameraserver
    group audio camera input drmrpc
    capabilities SYS_NICE
    rlimit rtprio 10 10
    stdio_to_kmsg
    seclabel u:r:cameraserver:s0

# The codecs (Codec 2.0 HALs: Samsung's MFC and Google's BigWave hardware, Dolby's), which
# cameraserver and the camera HAL use for video and JPEG; cameraserver waits for each one
# the vendor declares. As the vendor's rc files, with seclabels.
service android-hardware-media-c2-hal-1-2 /vendor/bin/hw/samsung.hardware.media.c2@1.2-service
    user mediacodec
    group camera mediadrm drmrpc
    ioprio rt 4
    seclabel u:r:mediacodec_samsung:s0

service android-hardware-media-c2-hal-2-0-google /vendor/bin/hw/google.hardware.media.c2@2.0-service
    user mediacodec
    group camera mediadrm drmrpc
    ioprio rt 4
    capabilities SYS_NICE
    seclabel u:r:mediacodec_google:s0

# Android's software codecs (the media.swcodec APEX), the "software" Codec 2.0 store
service media.swcodec /apex/com.android.media.swcodec/bin/mediaswcodec
    user mediacodec
    group camera drmrpc mediadrm
    ioprio rt 4
    seclabel u:r:mediaswcodec:s0

service vendor-dolby-media-c2-hal /vendor/bin/hw/vendor.dolby.media.c2-default-service
    user mediacodec
    group camera mediadrm drmrpc
    ioprio rt 4
    seclabel u:r:mediacodec:s0

# The TPU's vendor service, which the camera HAL's TPU stages ask for; started on demand
# (lazy), as the vendor's rc files have them, with seclabels.
service edgetpu_vendor_service /vendor/bin/hw/vendor.google.edgetpu_vendor_service@1.0-service
    interface aidl com.google.edgetpu.IEdgeTpuVendorService/default
    disabled
    oneshot
    user system
    group system
    seclabel u:r:edgetpu_vendor_server:s0

service edgetpu_tachyon_service /vendor/bin/hw/com.google.edgetpu.tachyon-service
    interface aidl com.google.edgetpu.tachyon.IComputeService/default
    oneshot
    disabled
    user system
    group system
    rlimit rtprio 99 99
    capabilities SYS_NICE IPC_LOCK
    seclabel u:r:edgetpu_tachyon_server:s0

on post-fs-data
    # (from the vendor's init.zumapro.board.rc)
    mkdir /data/vendor/edgetpu 0770 system system
    mkdir /data/vendor/edgetpu/cache 0770 system system
    symlink /dev/edgetpu-soc /dev/edgetpu
    mkdir /data/vendor/camera 0770 system camera
    mkdir /data/vendor/camera/catpipe 0770 system camera
    mkdir /data/vendor/camera/peripheral_probe_results 0770 system camera

on mobarchy-start
    start vendor.graphics.allocator-default
    start vendor.sensors-hal-multihal
    start android-hardware-media-c2-hal-1-2
    start android-hardware-media-c2-hal-2-0-google
    start vendor-dolby-media-c2-hal
    start media.swcodec
    # Not started yet: the camera HAL needs OpenCL on the GPU (HDRnet), which panthor
    # doesn't give it, and aborts. Without it it restarts every few seconds.
    #start vendor.camera-provider-2-7-google
    #start cameraserver

# The sensors (USF, on the AOC), through Android's sensor HAL: it loads the sensor registry
# (the vendor's, and the factory calibration in persist), which the camera HAL waits for
# (the gyro, for stabilisation). As the vendor's android.hardware.sensors-service-multihal.rc,
# with a seclabel.
import /vendor/etc/init/init.usf.rc

service vendor.sensors-hal-multihal /vendor/bin/hw/android.hardware.sensors-service.multihal
    user system
    group system wakelock context_hub input uhid audio
    task_profiles ServiceCapacityLow
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
    stdio_to_kmsg
    seclabel u:r:hal_sensors_default:s0
