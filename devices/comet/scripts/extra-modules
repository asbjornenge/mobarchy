#!/usr/bin/env bash
# Build the out-of-tree modules comet's rootfs loads besides the GPU's (--extra modules=<out>):
#   v4l2loopback.ko   the cameras as webcams (/usr/lib/mobarchy/webcam), upstream release
#
#   devices/comet/scripts/extra-modules --kernel-src <dir> --out <dir>
set -euo pipefail
repo="$(cd "$(dirname "$0")/../../.." && pwd)"
ksrc="" out=""
while [ $# -gt 0 ]; do
    case "$1" in
        --kernel-src) ksrc="$(realpath "$2")"; shift 2 ;;
        --out) out="$(realpath -m "$2")"; shift 2 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done
[ -n "$ksrc" ] && [ -n "$out" ] || { echo "usage: $0 --kernel-src <dir> --out <dir>" >&2; exit 2; }
mkdir -p "$out"
work="$out/.work"
obj="$ksrc/out/extmod-obj"

version=0.15.1
sha256=710e087bc786b7d9cdca48322494c360ef59d48c6a26f6c0053ea8e71efd3ee1
mkdir -p "$work"
curl -sfL -o "$work/v4l2loopback.tar.gz" "https://github.com/umlaeute/v4l2loopback/archive/refs/tags/v$version.tar.gz"
echo "$sha256  $work/v4l2loopback.tar.gz" | sha256sum -c --quiet
rm -rf "$work/v4l2loopback" && mkdir "$work/v4l2loopback"
tar -xzf "$work/v4l2loopback.tar.gz" -C "$work/v4l2loopback" --strip-components=1
"$repo/tools/kernel-build/extmod" --src "$ksrc" --device comet --obj "$obj" --module "$work/v4l2loopback"
cp "$work/v4l2loopback/v4l2loopback.ko" "$out/"
echo "modules in $out:"; ls -l "$out"/*.ko
