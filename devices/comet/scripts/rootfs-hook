#!/bin/bash
# comet additions to the rootfs. os/image/build runs this inside the arm64 build container,
# with the rootfs at /. Inputs (all optional, read-only):
#   /extra/kernel    Mobarchy kernel build output (tools/kernel-build/build): modules
#   /extra/firmware  vendor firmware from the factory image (unpacked vendor/firmware)
# Neither the modules nor the firmware are stored in the repo.
set -euo pipefail

if [ -d /extra/kernel ]; then
    k=/extra/kernel
    kver=$(modinfo -F vermagic "$(ls $k/*.ko | head -n1)" | cut -d' ' -f1)
    dst=/usr/lib/modules/$kver
    install -d "$dst/extra"
    install -m644 $k/*.ko "$dst/extra/"
    cp $k/modules.builtin $k/modules.builtin.modinfo "$dst/"
    depmod "$kver"
    # First-stage modules are loaded by the initramfs (vendor_kernel_boot). systemd loads
    # the rest in Android's order, minus the vendor blocklists.
    {
        echo "# Generated by devices/comet/scripts/rootfs-hook from the kernel build's module lists."
        cat $k/vendor_dlkm.modules.load $k/system_dlkm.modules.load \
            | xargs -n1 basename | sed 's/\.ko$//' \
            | grep -vxF -f <(sed -n 's/^blocklist //p' $k/vendor_dlkm.modules.blocklist $k/system_dlkm.modules.blocklist 2>/dev/null | sed 's/-/_/g; s/\.ko$//') \
            || true
    } > /etc/modules-load.d/mobarchy-comet.conf
    echo "comet: installed $(ls "$dst/extra" | wc -l) modules for $kver"
fi

if [ -d /extra/firmware ]; then
    install -d /usr/lib/firmware
    cp -r /extra/firmware/. /usr/lib/firmware/
    echo "comet: installed vendor firmware ($(du -sh /usr/lib/firmware | cut -f1))"
fi
