+    /// A buffer on imported memory (cl_arm_import_memory): a dma-buf, or `host` (the dma-buf
+    /// mapped, for devices that can't import it; the caller keeps it mapped as long as the
+    /// buffer lives).
+    pub fn new_imported_buffer(
+        context: Arc<Context>,
+        flags: cl_mem_flags,
+        size: usize,
+        fd: c_int,
+        host: *mut c_void,
+    ) -> CLResult<Arc<Buffer>> {
+        let res = context.import_dmabuf_buffer(fd, size, host)?;
+        Ok(Arc::new(Buffer {
+            base: Self {
+                base: CLObjectBase::new(RusticlTypes::Buffer),
+                context: context,
+                mem_type: CL_MEM_OBJECT_BUFFER,
+                flags: flags,
+                size: size,
+                props: Properties::default(),
+                gl_obj: None,
+                cbs: Mutex::new(Vec::new()),
+                alloc: Allocation::new(res, 0, host),
+            },
+            address: None,
+            maps: Mutex::new(TrackedPointers::new()),
+        }))
+    }
