+/// The CPU mapping of an imported dma-buf, unmapped when its buffer is destroyed.
+unsafe extern "C" fn unmap_imported(_mem: cl_mem, user_data: *mut c_void) {
+    // SAFETY: user_data is the Box import_dma_buf leaked for this buffer, given back once.
+    let (ptr, size) = *unsafe { Box::from_raw(user_data.cast::<(usize, usize)>()) };
+    unsafe { munmap(ptr as *mut c_void, size) };
+}
+
+/// cl_arm_import_memory_dma_buf: a buffer on a dma-buf. Drivers that can import dma-bufs use it
+/// directly; for the others (llvmpipe) it is mapped and used as host memory.
+fn import_dma_buf(c: Arc<Context>, flags: cl_mem_flags, fd: c_int, size: usize) -> CLResult<cl_mem> {
+    // CL_IMPORT_MEMORY_WHOLE_ALLOCATION_ARM (SIZE_MAX, which bindgen doesn't see)
+    let size = if size == usize::MAX {
+        // SAFETY: lseek only reads the fd's size; an invalid fd fails.
+        let end = unsafe { lseek(fd, 0, SEEK_END as c_int) };
+        usize::try_from(end).map_err(|_| CL_INVALID_VALUE)?
+    } else {
+        size
+    };
+    // CL_INVALID_BUFFER_SIZE if size is 0
+    if size == 0 {
+        return Err(CL_INVALID_BUFFER_SIZE);
+    }
+
+    let host = if c.devs.iter().all(|dev| dev.dma_buf_import_supported()) {
+        ptr::null_mut()
+    } else {
+        // SAFETY: a new shared mapping of the dma-buf; nothing else refers to its address.
+        let p = unsafe {
+            mmap(ptr::null_mut(), size, (PROT_READ | PROT_WRITE) as c_int, MAP_SHARED as c_int, fd, 0)
+        };
+        if p as isize == -1 {
+            return Err(CL_INVALID_VALUE);
+        }
+        p
+    };
+
+    let buffer = match MemBase::new_imported_buffer(c, flags, size, fd, host) {
+        Ok(buffer) => buffer,
+        Err(err) => {
+            if !host.is_null() {
+                // SAFETY: mapped above and not used by anything.
+                unsafe { munmap(host, size) };
+            }
+            return Err(err);
+        }
+    };
+    if !host.is_null() {
+        let data = Box::into_raw(Box::new((host as usize, size))).cast();
+        // SAFETY: unmap_imported is thread safe, and data is the Box it expects.
+        let cb = unsafe { MemCB::new(Some(unmap_imported), data)? };
+        buffer.cbs.lock().unwrap().push(cb);
+    }
+    Ok(buffer.into_cl())
+}
+
+#[cl_entrypoint(clImportMemoryARM)]
+fn import_memory_arm(
+    context: cl_context,
+    flags: cl_mem_flags,
+    properties: *const cl_import_properties_arm,
+    memory: *mut c_void,
+    size: usize,
+) -> CLResult<cl_mem> {
+    let c = Context::arc_from_raw(context)?;
+
+    // CL_INVALID_VALUE if memory is NULL, or if flags are not valid (the host pointer ones
+    // don't apply)
+    if memory.is_null() {
+        return Err(CL_INVALID_VALUE);
+    }
+    validate_mem_flags_create(flags, MemFlagValidationType::Plain)?;
+    if bit_check(flags, CL_MEM_USE_HOST_PTR | CL_MEM_ALLOC_HOST_PTR | CL_MEM_COPY_HOST_PTR) {
+        return Err(CL_INVALID_VALUE);
+    }
+
+    // CL_INVALID_PROPERTY if a property is not supported (the import type is the only one)
+    let props = unsafe { Properties::new(properties) }.ok_or(CL_INVALID_PROPERTY)?;
+    let mut import_type = CL_IMPORT_TYPE_HOST_ARM;
+    for (&key, &value) in props.iter() {
+        match key as u32 {
+            CL_IMPORT_TYPE_ARM => import_type = value as u32,
+            _ => return Err(CL_INVALID_PROPERTY),
+        }
+    }
+
+    match import_type {
+        // SAFETY: for a dma-buf, memory points to its fd (an int)
+        CL_IMPORT_TYPE_DMA_BUF_ARM => import_dma_buf(c, flags, unsafe { *memory.cast::<c_int>() }, size),
+        CL_IMPORT_TYPE_HOST_ARM => {
+            Ok(MemBase::new_buffer(c, flags | cl_mem_flags::from(CL_MEM_USE_HOST_PTR), size, memory, Properties::default())?
+                .into_cl())
+        }
+        _ => Err(CL_INVALID_PROPERTY),
+    }
+}
+
