+    /// Imports a dma-buf as a buffer (cl_arm_import_memory_dma_buf). A device whose driver
+    /// imports dma-bufs gets the dma-buf itself; for the others (llvmpipe), `host` is a CPU
+    /// mapping of it, used as host memory.
+    pub fn import_dmabuf_buffer(
+        &self,
+        fd: c_int,
+        size: usize,
+        host: *mut c_void,
+    ) -> CLResult<HashMap<&'static Device, PipeResourceOwned>> {
+        let adj_size: u32 = size.try_into_with_err(CL_INVALID_BUFFER_SIZE)?;
+        let mut res = HashMap::new();
+        for &dev in &self.devs {
+            let resource = dev
+                .screen()
+                .resource_import_dmabuf(
+                    fd as u32,
+                    0x00ff_ffff_ffff_ffff, // DRM_FORMAT_MOD_INVALID: a buffer has none
+                    pipe_texture_target::PIPE_BUFFER,
+                    pipe_format::PIPE_FORMAT_NONE,
+                    0,
+                    adj_size,
+                    1,
+                    1,
+                    1,
+                    false,
+                )
+                .or_else(|| {
+                    (!host.is_null()).then(|| {
+                        dev.screen()
+                            .resource_create_buffer_from_user(adj_size, host, PIPE_BIND_GLOBAL, 0)
+                    })?
+                })
+                .ok_or(CL_INVALID_OPERATION)?;
+            res.insert(dev, resource);
+        }
+        Ok(res)
+    }
