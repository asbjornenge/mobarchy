# The sensors of Mobarchy's Android container: ISensorManager for its HALs, the sensor bridge
# (both built with the NDK beforehand: make ndk) and its Linux side, mobarchy-sensor-proxy
# (net.hadess.SensorProxy; ADR 0020).
#   tools/repo-build --repo <dir> os/android-sensors
pkgname=mobarchy-android-sensors
pkgver=0.2
pkgrel=2
pkgdesc="The sensors of Mobarchy's Android container: for its HALs, and for Linux as iio-sensor-proxy offers them"
arch=(aarch64)
depends=(glib2 dbus)
makedepends=(pkgconf)
provides=(iio-sensor-proxy)
conflicts=(iio-sensor-proxy)
options=(!debug !strip)

prepare() {
    for f in mobarchy-sensormanager mobarchy-sensord; do
        [ -x "$startdir/$f" ] || { echo "no $f: build it with the NDK first (make ndk)" >&2; return 1; }
    done
    rm -rf "$srcdir/sensors" && mkdir -p "$srcdir/sensors"
    cp -r "$startdir"/{Makefile,protocol.h,proxy,mobarchy-sensormanager,mobarchy-sensord} "$srcdir/sensors"
    make -C "$srcdir/sensors/proxy" clean
}

build() {
    make -C "$srcdir/sensors" proxy
}

package() {
    make -C "$srcdir/sensors" DESTDIR="$pkgdir" install
}
