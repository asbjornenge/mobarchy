[Desktop Entry]
Type=Application
Name=Browser
GenericName=Web Browser
Comment=Browse the web, made for the phone
Exec=mobarchy-browser %U
Icon=web-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=org.mobarchy.Browser
