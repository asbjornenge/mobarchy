#!/usr/bin/env bash
# Build the Mobarchy aarch64 rootfs image (Arch Linux ARM + Mobarchy stack) for a device.
#
#   os/image/build --device <codename> --base <ArchLinuxARM-aarch64-latest.tar.gz> --out <dir>
#                  --repo <Mobarchy package repository> [--repo-url URL [--repo-credentials FILE]]
#                  [--size 8G] [--extra NAME=DIR ...]
#
# Runs pacman inside an arm64 container (needs qemu-user binfmt on the host). The
# result is <out>/rootfs.img (ext4) and <out>/rootfs.tar. Device-specific additions
# (kernel modules, firmware links, fstab) come from devices/<codename>/scripts/rootfs-hook
# if that script exists. It runs inside the container with the rootfs at /, and sees each
# --extra NAME=DIR read-only at /extra/NAME (e.g. kernel build output, vendor firmware).
# --repo is Mobarchy's own package repository (tools/repo-build): it comes before Arch's,
# so its packages win (patched ones too), and packages-mobarchy.txt is installed from it.
# --repo-url is where devices find that repository later (pacman -Syu); without it, the
# image has no [mobarchy] section and takes Mobarchy updates only from new images.
# --repo-credentials is a file with MOBARCHY_REPO_USER= and MOBARCHY_REPO_PASSWORD= (kept
# outside the repo) for a repository behind basic auth: they go in the image's
# /etc/pacman.d/mobarchy-server (root:wheel 640), not in pacman.conf.
#
# Access: ssh as "mob" with the key ~/.config/mobarchy/device_ed25519 (created on first
# build, kept outside the repo).
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
device="" base="" out="" repo="" repo_url="" repo_auth="" size=8G extra=()
while [ $# -gt 0 ]; do
    case "$1" in
        --device) device="$2"; shift 2 ;;
        --base) base="$(realpath "$2")"; shift 2 ;;
        --out) out="$(realpath -m "$2")"; shift 2 ;;
        --size) size="$2"; shift 2 ;;
        --repo) repo="$(realpath "$2")"; shift 2 ;;
        --repo-url) repo_url="$2"; shift 2 ;;
        --repo-credentials) repo_auth=$(. "$2" && echo "$MOBARCHY_REPO_USER:$MOBARCHY_REPO_PASSWORD"); shift 2 ;;
        --extra) extra+=(-v "$(realpath "${2#*=}"):/extra/${2%%=*}:ro"); shift 2 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done
[ -n "$device" ] && [ -n "$base" ] && [ -n "$out" ] && [ -n "$repo" ] || {
    echo "usage: $0 --device <codename> --base <tarball> --repo <dir> --out <dir>" >&2; exit 2; }
[ -f "$repo/mobarchy.db" ] || { echo "$repo is no Mobarchy package repository (tools/repo-build)" >&2; exit 1; }
mkdir -p "$out"
name="mobarchy-rootfs-$device"

# 1. Base image from the (signature-verified) Arch Linux ARM tarball.
base_img="mobarchy-alarm-base:$(sha256sum "$base" | cut -c1-12)"
docker image inspect "$base_img" >/dev/null 2>&1 || docker import --platform linux/arm64 "$base" "$base_img" >/dev/null

# 2. Install packages and the Mobarchy tree in an arm64 container.
docker rm -f "$name" >/dev/null 2>&1 || true
pubkey_file="$HOME/.config/mobarchy/device_ed25519.pub"
mkdir -p "$(dirname "$pubkey_file")"
[ -f "$pubkey_file" ] || ssh-keygen -q -t ed25519 -N "" -C mobarchy-device -f "${pubkey_file%.pub}"
docker run --platform linux/arm64 --name "$name" -e MOBARCHY_SSH_PUBKEY="$(cat "$pubkey_file")" \
    -e REPO_URL="$repo_url" -e REPO_AUTH="$repo_auth" -v "$repo_root:/src:ro" -v "$repo:/extra/mobarchy-repo:ro" "${extra[@]}" \
    "$base_img" /bin/bash -euo pipefail -c '
    device='"$device"'
    pacman-key --init >/dev/null && pacman-key --populate archlinuxarm >/dev/null
    # The stock kernel and bootloader bits are for SBCs; the device brings its own kernel.
    pacman -Rdd --disable-sandbox --noconfirm linux-aarch64 $(pacman -Qq | grep "^linux-firmware") >/dev/null 2>&1 || true
    # The pacman download sandbox (Landlock, alpm user) does not work under qemu-user emulation.
    # The Mobarchy repository first: its packages win over those of the same name in Arch.
    sed -i "/^\[core\]/i [mobarchy]\nSigLevel = Optional TrustAll\nServer = file:///extra/mobarchy-repo\n" /etc/pacman.conf
    grep -q "^\[mobarchy\]" /etc/pacman.conf
    grep -hv "^#" /src/os/image/packages.txt /src/os/image/packages-mobarchy.txt \
        | xargs pacman -Syu --disable-sandbox --noconfirm --needed >/dev/null
    pacman -Sl mobarchy | awk "/\[installed/{print \$2}" > /tmp/mobarchy-installed
    echo "installed from the Mobarchy repository: $(tr "\n" " " < /tmp/mobarchy-installed)"
    # Where the device finds the repository from now on (or no repository).
    python3 - <<EOP
import grp, os, re
c = open("/etc/pacman.conf").read()
url = os.environ.get("REPO_URL", "")
auth = os.environ.get("REPO_AUTH", "")
section = f"[mobarchy]\nSigLevel = Optional TrustAll\nServer = {url}\n\n" if url else ""
if url and auth:
    # (the password in a file of its own, not in the world-readable pacman.conf)
    scheme, rest = url.split("://", 1)
    with open("/etc/pacman.d/mobarchy-server", "w") as f:
        f.write(f"Server = {scheme}://{auth}@{rest}\n")
    os.chmod("/etc/pacman.d/mobarchy-server", 0o640)
    os.chown("/etc/pacman.d/mobarchy-server", 0, grp.getgrnam("wheel").gr_gid)
    section = "[mobarchy]\nSigLevel = Optional TrustAll\nInclude = /etc/pacman.d/mobarchy-server\n\n"
c = re.sub(r"\[mobarchy\]\n(?:[^\[\n].*\n)*\n?", section, c, count=1)
open("/etc/pacman.conf", "w").write(c)
EOP
    rm -rf /var/cache/pacman/pkg/*

    # Owner account: autologin on tty1 starts Hyprland (same as the simulator).
    userdel -r alarm 2>/dev/null || true
    useradd -m -G wheel,video,input,audio -s /bin/bash mob
    # sudo asks the owner (ADR 0022): a finger or the PIN on the phone; over ssh (a key
    # login) /etc/pam.d/sudo lets it through.
    echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/wheel && chmod 440 /etc/sudoers.d/wheel
    passwd -l root >/dev/null
    cat > /home/mob/.bash_profile <<EOP
[ -f ~/.bashrc ] && . ~/.bashrc
if [ "\$(tty)" = /dev/tty1 ]; then exec start-hyprland > ~/.hyprland.log 2>&1; fi
EOP

    # Mobarchy tree: generic overlay, then device overlay, device description, session config.
    # Overlays are installed root-owned without group/other write, and existing
    # directories (/etc, /usr/bin, ...) keep their own owner and mode.
    overlay() { tar -C "$1" -cf - --owner=0 --group=0 --mode=go-w . | tar -C / -xf - --no-overwrite-dir; }
    overlay /src/os/rootfs
    [ -d /src/devices/$device/rootfs ] && overlay /src/devices/$device/rootfs
    install -Dm644 /src/devices/$device/device.toml /etc/mobarchy/device.toml
    mkdir -p /home/mob/.config && cp -r --no-preserve=ownership /src/os/config/. /home/mob/.config/
    python3 - <<EOP
import tomllib
dev = tomllib.load(open("/etc/mobarchy/device.toml", "rb"))
lines = ["# Generated from devices/$device/device.toml by os/image/build"]
lines.append("monitor = , preferred, auto, auto")
open("/home/mob/.config/hypr/device.conf", "w").write("\n".join(lines) + "\n")
EOP
    if [ -n "${MOBARCHY_SSH_PUBKEY:-}" ]; then
        install -d -m700 /home/mob/.ssh && echo "$MOBARCHY_SSH_PUBKEY" > /home/mob/.ssh/authorized_keys
        chmod 600 /home/mob/.ssh/authorized_keys
    fi
    glib-compile-schemas /usr/share/glib-2.0/schemas

    chown -R mob:mob /home/mob

    systemctl enable sshd systemd-networkd systemd-resolved wpa_supplicant@wlan0 mobarchy-usb-gadget mobarchy-session mobarchy-widevine mobarchy-location mobarchy-mobile-data mobarchy-suspend mobarchy-mce systemd-oomd >/dev/null 2>&1
    systemctl set-default graphical.target >/dev/null 2>&1
    systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target >/dev/null 2>&1
    sed -i "s/^#en_US.UTF-8/en_US.UTF-8/" /etc/locale.gen && locale-gen >/dev/null && echo LANG=en_US.UTF-8 > /etc/locale.conf
    [ -x /src/devices/$device/scripts/rootfs-hook ] && /src/devices/$device/scripts/rootfs-hook
    # The packages from the Mobarchy repository (built here, against what was current then)
    # find every library they link to. Mesa built against an older LLVM left the GPU
    # without a driver, and Hyprland crashing, with nothing said here.
    # (Plugins for Qt Designer, which only Qt Designer loads, are left out: it is not on a
    # phone.)
    broken=$(xargs -r pacman -Qlq < /tmp/mobarchy-installed | grep -v "/\$" | grep -v "/qt6/plugins/designer/" | xargs -r -P8 -n40 sh -c \
        "for f; do [ -f \"\$f\" ] && head -c4 \"\$f\" | grep -q ELF && ldd \"\$f\" 2>/dev/null | grep -q \"not found\" && echo \"\$f: \$(ldd \"\$f\" | grep \"not found\" | tr -s \" \" | tr \"\n\" \" \")\"; done; true" sh)
    if [ -n "$broken" ]; then echo "libraries missing what they link to:"; echo "$broken"; exit 1; fi
    echo "rootfs ready"
'

# A quote inside the script above ends it early, silently: check that it got to the end.
docker logs "$name" 2>/dev/null | grep -q "^rootfs ready$" || { echo "the rootfs script stopped early (see above)" >&2; exit 1; }

# 3. Export and pack into an ext4 image.
docker export "$name" > "$out/rootfs.tar"
docker rm "$name" >/dev/null
docker run --rm -v "$out:/out" mobarchy-androidtools bash -euo pipefail -c "
    rm -rf /tmp/r && mkdir /tmp/r && tar -xpf /out/rootfs.tar -C /tmp/r --numeric-owner
    rm -f /tmp/r/.dockerenv
    rm -f /out/rootfs.img && mkfs.ext4 -q -L mobarchy -d /tmp/r /out/rootfs.img $size
    chown $(id -u):$(id -g) /out/rootfs.img
"
echo "built $out/rootfs.img ($size, $(du -h "$out/rootfs.img" | cut -f1) used)"
