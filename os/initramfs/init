#!/bin/sh
# Mobarchy debug init (PID 1 in the initramfs).
#
# Goal: the smallest thing that proves a device boots our code and gives us a shell.
#   1. mount pseudo filesystems and populate /dev (devtmpfs if the kernel has it, else mdev)
#   2. load kernel modules in the vendor's order (/lib/modules/modules.load)
#   3. expose a USB gadget: NCM network + ACM serial console
#   4. serve a telnet shell on 172.16.42.1 and a shell on the USB serial console
#   5. if a root partition is configured, mount it and switch_root into its init
#      (systemd); on any failure stay in the debug shell
#
# Root selection: ROOT_PARTNAME in initramfs.conf or mobarchy.root=<partname> on the kernel
# command line (the command line wins). mobarchy.debug on the command line never switches.
#
# Everything is logged to /dev/kmsg with the "mobarchy:" prefix, so it also ends up in
# pstore (ramoops) and can be read after a reboot if boot fails.
#
# Device specifics come from /etc/mobarchy/initramfs.conf (from devices/<codename>/).

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

USB_VENDOR=0x1d6b          # Linux Foundation
USB_PRODUCT=0x0104         # Multifunction Composite Gadget
USB_MANUFACTURER=Mobarchy
USB_PRODUCT_NAME="Mobarchy debug"
USB_SERIAL=mobarchy
USB_IP=172.16.42.1
HOST_IP=172.16.42.2
# Fixed NCM MAC addresses, so the host sees the same interface (enx02...) on every boot.
USB_HOST_MAC=02:6d:6f:62:00:01
USB_DEV_MAC=02:6d:6f:62:00:02
ROOT_PARTNAME=""
EARLY_MODULES_UNTIL=""     # load modules.load up to this module before USB; the rest after
USB_UDC=""                 # UDC to bind (default: the first one)
DIAG_TIMEOUT=""            # if set: seconds to wait for a USB host; then log diagnostics and
                           # reboot to the bootloader, so the log can be read from pstore
MODULE_TIMEOUT=10          # seconds per insmod before moving on
MODULE_SKIP=""             # module basenames (without .ko) never loaded by the debug init
PRELOAD_MODULES=""         # modules (file names) loaded first, in this order, e.g. a watchdog
WATCHDOG=0                 # 1: pet /dev/watchdog0 from userspace (busybox watchdog)
SCREENLOG=1                # show the log on the display (0 to keep the display untouched)
[ -f /etc/mobarchy/initramfs.conf ] && . /etc/mobarchy/initramfs.conf

log() {
    echo "mobarchy: $*" > /dev/kmsg 2>/dev/null
    echo "mobarchy: $*"
    echo "$(cut -d' ' -f1 /proc/uptime 2>/dev/null) $*" >> /run/mobarchy.log 2>/dev/null
}

mount_pseudo() {
    mkdir -p /proc /sys /dev /run /tmp
    mount -t proc proc /proc
    mount -t sysfs sysfs /sys
    # mobarchy.nodevtmpfs on the kernel command line exercises the mdev path on kernels that
    # have devtmpfs (for testing what stock Pixel kernels need).
    if grep -qw devtmpfs /proc/filesystems && ! grep -qw mobarchy.nodevtmpfs /proc/cmdline; then
        mount -t devtmpfs devtmpfs /dev
    else
        mount -t tmpfs -o mode=0755 tmpfs /dev
        mknod -m 600 /dev/kmsg c 1 11
        mknod -m 666 /dev/null c 1 3
        mknod -m 600 /dev/console c 5 1
    fi
    mkdir -p /dev/pts
    mount -t devpts devpts /dev/pts
    mount -t tmpfs tmpfs /run
    mount -t tmpfs tmpfs /tmp
    mount -t configfs configfs /sys/kernel/config 2>/dev/null
    mount -t pstore pstore /sys/fs/pstore 2>/dev/null
    mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
}

populate_dev() {
    # No-op with devtmpfs; otherwise create nodes from sysfs.
    grep -qw devtmpfs /proc/mounts || mdev -s
}

module_args() {  # parameters for a module from the kernel command line (<module>.<param>=<value>)
    local n
    n=$(basename "$1" .ko | tr '-' '_')
    tr ' ' '\n' < /proc/cmdline | sed -n "s/^$n\.//p" | tr '\n' ' '
}

insmod_timed() {  # insmod with a time budget; a module stuck in probe must not block boot
    local ko=$1 i=0 pid
    # Like modprobe, pass the module's parameters from the kernel command line. Android's
    # bootloaders put required ones there (panel names, UFS FIPS LBAs, Type-C config, ...).
    insmod "$ko" $(module_args "$ko") 2>/tmp/insmod.err &
    pid=$!
    while kill -0 $pid 2>/dev/null; do
        i=$((i + 1))
        [ $i -ge $((MODULE_TIMEOUT * 10)) ] && { log "insmod $(basename "$ko") still running after ${MODULE_TIMEOUT}s, moving on"; return 2; }
        sleep 0.1
    done
    wait $pid && return 0
    log "insmod $(basename "$ko") failed: $(cat /tmp/insmod.err)"
    return 1
}

# Dependency-aware loading, like modprobe: a module's dependencies (modules.dep) and
# pre-softdeps (modules.softdep) are loaded before the module itself. The vendor's
# modules.load gives the order of the top-level modules only.
#
# Two layouts exist: Android factory ramdisks keep everything flat in /lib/modules with
# absolute paths in modules.dep; kernels we build (Kleaf) use the standard
# /lib/modules/<release>/ tree with relative paths. MODDIR is whichever has modules.load.
MODDIR=/lib/modules
[ -f $MODDIR/modules.load ] || MODDIR=/lib/modules/$(uname -r)

module_name() { basename "$1" .ko | tr '-' '_'; }
is_loaded() { grep -q "^$(module_name "$1") " /proc/modules; }
module_file() {  # path as written in modules.dep/modules.load -> file on disk
    case "$1" in /*) echo "$1" ;; *) echo "$MODDIR/$1" ;; esac
}
module_key() {  # module name or file name -> its path key in modules.dep
    local n
    n=$(module_name "$1")
    sed -n 's/:.*//p' $MODDIR/modules.dep 2>/dev/null \
        | while read -r k; do [ "$(module_name "$k")" = "$n" ] && { echo "$k"; break; }; done
}

load_module() {  # load_module <path from modules.load/dep, or a bare file name>
    local key m ko d
    case "$1" in */*) key=$1 ;; *) key=$(module_key "$1") ;; esac
    [ -n "$key" ] || { log "module $1 not found"; return 1; }
    m=$(basename "$key")
    case " $MODULE_SKIP " in *" ${m%.ko} "*) return 0 ;; esac
    is_loaded "$m" && return 0
    grep -qx "$m" /run/mobarchy-modules.visiting 2>/dev/null && return 0  # dependency cycle guard
    echo "$m" >> /run/mobarchy-modules.visiting
    # Like modprobe: the last listed dependency is the most basic one, so start there.
    for d in $(grep -m1 "^$key:" $MODDIR/modules.dep 2>/dev/null | cut -d: -f2 | tr ' ' '\n' | tac); do
        load_module "$d"
    done
    for d in $(sed -n "s/^softdep $(module_name "$m") pre: //p" $MODDIR/modules.softdep 2>/dev/null); do
        load_module "$d.ko" 2>/dev/null
    done
    ko=$(module_file "$key")
    [ -f "$ko" ] || { log "module $m not found"; return 1; }
    echo "$(cut -d' ' -f1 /proc/uptime) $m" >> /run/mobarchy-modules.log
    insmod_timed "$ko"
}

load_modules() {  # load_modules <first line> <last line|$>: a slice of modules.load
    local list=$MODDIR/modules.load ok=0 fail=0 m
    [ -f "$list" ] || { log "no $list, skipping module loading"; return; }
    for m in $(sed -n "$1,$2p" "$list"); do
        [ -c /dev/dri/card0 ] || { [ -e /sys/class/drm/card0 ] && mdev -s; }  # let screenlog start early
        if load_module "$m"; then ok=$((ok + 1)); else fail=$((fail + 1)); fi
    done
    log "modules $1-$2 loaded: $ok ok, $fail failed or pending"
}

early_modules_end() {  # line in modules.load after which USB can come up (EARLY_MODULES_UNTIL)
    local n
    [ -n "$EARLY_MODULES_UNTIL" ] && [ -f $MODDIR/modules.load ] || { echo '$'; return; }
    n=$(grep -n "$EARLY_MODULES_UNTIL" $MODDIR/modules.load | head -n1 | cut -d: -f1)
    echo "${n:-\$}"
}

setup_usb_gadget() {
    local g=/sys/kernel/config/usb_gadget/mobarchy udc i
    [ -d /sys/kernel/config/usb_gadget ] || { log "no usb_gadget configfs"; return 1; }
    # The UDC can appear late (after its module and PHY come up).
    for i in $(seq 1 50); do
        udc=${USB_UDC:-$(ls /sys/class/udc 2>/dev/null | head -n1)}
        [ -n "$udc" ] && [ -e "/sys/class/udc/$udc" ] && break
        sleep 0.2
    done
    [ -n "$udc" ] || { log "no USB device controller found"; return 1; }

    mkdir -p $g
    echo $USB_VENDOR > $g/idVendor
    echo $USB_PRODUCT > $g/idProduct
    mkdir -p $g/strings/0x409
    echo "$USB_MANUFACTURER" > $g/strings/0x409/manufacturer
    echo "$USB_PRODUCT_NAME" > $g/strings/0x409/product
    echo "$USB_SERIAL" > $g/strings/0x409/serialnumber
    mkdir -p $g/configs/c.1/strings/0x409
    echo "NCM + ACM" > $g/configs/c.1/strings/0x409/configuration

    mkdir -p $g/functions/ncm.usb0 && {
        echo "$USB_HOST_MAC" > $g/functions/ncm.usb0/host_addr
        echo "$USB_DEV_MAC" > $g/functions/ncm.usb0/dev_addr
    } 2>/dev/null
    mkdir -p $g/functions/ncm.usb0 && ln -s $g/functions/ncm.usb0 $g/configs/c.1/ \
        || log "ncm function unavailable"
    mkdir -p $g/functions/acm.GS0 && ln -s $g/functions/acm.GS0 $g/configs/c.1/ \
        || log "acm function unavailable"

    echo "$udc" > $g/UDC || { log "binding gadget to $udc failed"; return 1; }
    # Devices may need a nudge to start a device-mode session (initramfs.conf hook).
    type usb_post_bind >/dev/null 2>&1 && usb_post_bind
    log "usb gadget bound to $udc"
}

setup_network() {
    local ifc
    ifc=$(cat /sys/kernel/config/usb_gadget/mobarchy/functions/ncm.usb0/ifname 2>/dev/null)
    [ -n "$ifc" ] && [ "$ifc" != "(unnamed net_device)" ] || ifc=usb0
    ip link set lo up
    ip addr add $USB_IP/24 dev "$ifc" && ip link set "$ifc" up || { log "no $ifc interface"; return 1; }
    cat > /etc/udhcpd.conf <<EOF
start $HOST_IP
end $HOST_IP
interface $ifc
option subnet 255.255.255.0
EOF
    touch /var/lib/udhcpd.leases 2>/dev/null || { mkdir -p /var/lib && touch /var/lib/udhcpd.leases; }
    udhcpd -S /etc/udhcpd.conf
    telnetd -l /bin/sh -b $USB_IP
    log "telnet shell on $USB_IP (host gets $HOST_IP via DHCP)"
}

cmdline_arg() {  # value of key=value on the kernel command line
    tr ' ' '\n' < /proc/cmdline | sed -n "s/^$1=//p" | tail -n1
}

find_partition() {  # block device for a GPT partition name, e.g. userdata
    local u name
    for u in /sys/class/block/*/uevent; do
        name=$(sed -n 's/^PARTNAME=//p' "$u")
        [ "$name" = "$1" ] && { echo "/dev/$(sed -n 's/^DEVNAME=//p' "$u")"; return 0; }
    done
    return 1
}

switch_to_root() {
    local part dev
    part=$(cmdline_arg mobarchy.root); [ -n "$part" ] || part=$ROOT_PARTNAME
    [ -n "$part" ] || { log "no root partition configured, staying in debug shell"; return 1; }
    grep -qw mobarchy.debug /proc/cmdline && { log "mobarchy.debug set, staying in debug shell"; return 1; }
    dev=$(find_partition "$part") || { log "partition $part not found"; return 1; }
    [ -b "$dev" ] || mdev -s
    mkdir -p /newroot
    mount -o rw,noatime "$dev" /newroot || { log "cannot mount $dev ($part)"; return 1; }
    [ -x /newroot/sbin/init ] || [ -L /newroot/sbin/init ] || { log "$part has no /sbin/init"; umount /newroot; return 1; }
    log "switching root to $dev ($part)"
    # Hand over: stop our services, keep the gadget bound (the rootfs takes it over).
    killall telnetd udhcpd 2>/dev/null
    if [ -n "$SPLASHING" ]; then
        echo "$SCREENLOG_PID" > /run/mobarchy-splash.pid
    elif [ -n "$SCREENLOG_PID" ]; then
        kill "$SCREENLOG_PID" 2>/dev/null
    fi
    [ -n "${SERIAL_LOOP:-}" ] && kill "$SERIAL_LOOP" 2>/dev/null && pkill -f 'exec sh </dev/ttyGS0'
    for m in dev proc sys run; do mkdir -p /newroot/$m; mount --move /$m /newroot/$m; done
    exec switch_root /newroot /sbin/init
}

serial_shell() {
    # Respawn a shell on the USB serial console (ttyGS0) forever.
    [ -e /dev/ttyGS0 ] || { mdev -s; [ -e /dev/ttyGS0 ] || return; }
    ( while true; do setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done ) &
    SERIAL_LOOP=$!
    log "shell on USB serial /dev/ttyGS0"
}

mount_pseudo
log "init started ($(uname -r), $(uname -m))"
populate_dev
# USB first: it is our only window into the device. Load the modules it needs (a prefix of
# the vendor's load order), bring up the gadget, then load the rest.
# Show our log on the display as soon as a DRM device appears (screenlog waits for it).
# Some SoCs come out of the bootloader with a hardware watchdog armed. Its driver has to
# be up (and the watchdog petted) long before the rest of the modules are loaded.
if [ -n "$PRELOAD_MODULES" ]; then
    for m in $PRELOAD_MODULES; do load_module "$m" && log "preloaded $m"; done
    populate_dev
fi
if [ "$WATCHDOG" = 1 ]; then
    # The watchdog device node can show up after its driver finishes probing; wait for it
    # in the background and pet it from then on.
    (
        for i in $(seq 1 300); do
            [ -e /sys/class/watchdog/watchdog0 ] && { [ -c /dev/watchdog0 ] || mdev -s; }
            [ -c /dev/watchdog0 ] && break
            sleep 0.1
        done
        if [ -c /dev/watchdog0 ]; then
            watchdog -t 5 -T 30 /dev/watchdog0 && log "petting /dev/watchdog0 (after ${i}00 ms)"
        else
            log "no watchdog device after 30 s"
        fi
    ) &
fi

# The splash (Mobarchy's logo, breathing) instead of the log, unless mobarchy.debug is set: it
# turns into the log if the boot goes wrong here, and is left running across switch_root
# for the session to end (mobarchy-session's splash-stop), so the screen stays lit.
SCREENLOG_PID="" SPLASHING=""
if [ "$SCREENLOG" = 1 ]; then
    if [ "${SPLASH:-0}" = 1 ] && [ -f /usr/share/mobarchy/splash.mspl ] && ! grep -qw mobarchy.debug /proc/cmdline; then
        SPLASH_TRANSFORM="$SPLASH_TRANSFORM" mobarchy-screenlog --splash /usr/share/mobarchy/splash.mspl \
            /run/mobarchy.log ${SCREENLOG_SCALE:-2} 2>>/run/mobarchy.log &
        SPLASHING=1
    else
        mobarchy-screenlog /run/mobarchy.log ${SCREENLOG_SCALE:-2} 2>>/run/mobarchy.log &
    fi
    SCREENLOG_PID=$!
fi
early=$(early_modules_end)
load_modules 1 "$early"
populate_dev
setup_usb_gadget && { populate_dev; setup_network; serial_shell; }
if [ "$early" != '$' ]; then
    load_modules $((early + 1)) '$'
    populate_dev
fi

diagnose_usb() {  # log USB state; with DIAG_TIMEOUT, reboot to bootloader if no host shows up
    # (only when there is no root to switch to: a phone away from a PC must still boot)
    local udc st i=0
    [ -n "$DIAG_TIMEOUT" ] || return 0
    udc=${USB_UDC:-$(ls /sys/class/udc 2>/dev/null | head -n1)}
    while [ $i -lt "$DIAG_TIMEOUT" ]; do
        st=$(cat /sys/class/udc/$udc/state 2>/dev/null)
        [ "$st" = configured ] && { log "usb: host connected (udc $udc configured)"; return 0; }
        sleep 1; i=$((i + 1))
    done
    log "diag: no USB host after ${DIAG_TIMEOUT}s; udc=$udc state=$st"
    log "diag: udcs: $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"
    log "diag: gadget UDC: $(cat /sys/kernel/config/usb_gadget/mobarchy/UDC 2>/dev/null)"
    for f in /sys/class/typec/port0/data_role /sys/class/typec/port0/power_role /sys/class/typec/port0/*/uevent \
             /sys/devices/platform/11210000.usb/dwc3_exynos_otg_b_sess /sys/devices/platform/11210000.usb/dwc3_exynos_otg_id \
             /sys/devices/platform/11210000.usb/usb_data_enabled; do
        [ -e "$f" ] && log "diag: $f = $(tr '\n' ' ' < "$f" 2>/dev/null)"
    done
    log "diag: modules loaded: $(wc -l < /proc/modules)"
    log "diag: last module lines: $(tail -n 3 /run/mobarchy-modules.log 2>/dev/null | tr '\n' ' ')"
    dmesg | grep -iE "dwc3|udc|gadget|tcpc|tcpm|typec|usb|max77759" | tail -n 40 | while read -r l; do log "diag-dmesg: $l"; done
    sync
    log "diag: rebooting to bootloader"
    sleep 2
    reboot-to bootloader
}

switch_to_root
# (still here: the boot went wrong, or a debug boot; the splash shows the log instead)
[ -n "$SPLASHING" ] && kill -USR1 "$SCREENLOG_PID" 2>/dev/null
diagnose_usb

# Leave a trace of how far we got for the next boot (pstore) and for the host.
log "debug init ready"
echo "Mobarchy debug initramfs. Telnet: $USB_IP" > /etc/motd

# PID 1 must never exit. Offer a console shell if there is a console, else just wait.
if [ -c /dev/console ]; then
    while true; do setsid sh -c 'exec sh </dev/console >/dev/console 2>&1'; sleep 1; done
fi
while true; do sleep 3600; done
