#!/bin/sh
# Minimal modprobe for the debug initramfs. Android GKI kernels call
# CONFIG_MODPROBE_PATH (/system/bin/modprobe) themselves, very early, before /init
# runs, to load pKVM hypervisor modules (kvm-arm.protected_modules). That has to work,
# or the modules that depend on them (IOMMUs, UFS inline crypto, ...) fail later.
# It resolves /lib/modules/modules.dep like the real thing. /proc may not be mounted.
PATH=/bin:/sbin
dir=/lib/modules
names=""
for a in "$@"; do
    case "$a" in -*) ;; *) names="$names $a" ;; esac
done

load() {  # load <file.ko>: dependencies first (last listed = most basic), then the module
    local m=$1 d
    for d in $(sed -n "s|^\(.*/\)\{0,1\}$m:||p" $dir/modules.dep 2>/dev/null | tr ' ' '\n' | tac); do
        load "$(basename "$d")"
    done
    n=$(basename "$m" .ko | tr '-' '_')
    insmod "$dir/$m" $(tr ' ' '\n' < /proc/cmdline 2>/dev/null | sed -n "s/^$n\.//p") 2>/dev/null
    return 0
}

rc=0
for n in $names; do
    f=""
    for c in "$n" "$(echo "$n" | tr '_' '-')" "$(echo "$n" | tr '-' '_')"; do
        [ -f "$dir/$c.ko" ] && { f="$c.ko"; break; }
    done
    if [ -n "$f" ]; then load "$f"; else rc=1; fi
done
exit $rc
