def orb_points():
    """A sphere of points (Fibonacci), seen from the front: (x, y, depth 0..1)."""
    pts = []
    for i in range(26):
        y = 1 - (i / 25) * 2
        r = math.sqrt(1 - y * y)
        th = i * 2.39996
        pts.append((CX + math.cos(th) * r * R * 0.86, CY + y * R * 0.86, (math.sin(th) * r + 1) / 2))
    lines = []
    for i, a in enumerate(pts):
        near = sorted((math.dist(a[:2], b[:2]), j) for j, b in enumerate(pts) if j != i)[:3]
        for _, j in near:
            if (j, i) not in lines:
                lines.append((i, j))
    return pts, lines


def svg(pulse: float, background: bool = True) -> str:
    """The logo with the orb at pulse 0..1 (0: at rest, 1: the breath's top)."""
    pts, lines = orb_points()
    glow = 0.18 + 0.22 * pulse
    lo = 0.18 + 0.25 * pulse
    out = [f'''<svg xmlns="http://www.w3.org/2000/svg" width="{SIZE}" height="{SIZE}" viewBox="0 30 512 452">
<defs>
  <linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7aa2f7"/><stop offset="1" stop-color="#bb9af7"/></linearGradient>
  <radialGradient id="glow" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#bb9af7" stop-opacity="{glow:.3f}"/><stop offset="1" stop-color="#bb9af7" stop-opacity="0"/></radialGradient>
  <clipPath id="orb"><circle cx="{CX}" cy="{CY}" r="{R - 10}"/></clipPath>
</defs>''']
    if background:
        out.append(f'<rect x="0" y="0" width="512" height="512" fill="{BG}"/>')
    out.append(f'<circle cx="{CX}" cy="{CY}" r="{R * 1.5}" fill="url(#glow)"/>')
    out.append('<g clip-path="url(#orb)">')
    for i, j in lines:
        a, b = pts[i], pts[j]
        out.append(f'<line x1="{a[0]:.1f}" y1="{a[1]:.1f}" x2="{b[0]:.1f}" y2="{b[1]:.1f}" stroke="url(#g)" '
                   f'stroke-width="2" opacity="{lo * (0.6 + 0.4 * a[2]):.2f}"/>')
    for x, y, z in pts:
        out.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="{2.5 + 2 * z + 1.5 * pulse:.1f}" fill="#c0caf5" '
                   f'opacity="{(0.3 + 0.5 * z) * (0.6 + 0.4 * pulse):.2f}"/>')
    out.append('</g>')
    out.append(f'''<g fill="none" stroke="url(#g)" stroke-width="14" stroke-linecap="round" stroke-linejoin="round">
  <circle cx="{CX}" cy="{CY}" r="{R}"/>
  <path d="M168 352 L196 92 L256 230 L316 92 L344 352"/>
</g>
<path fill="#c0caf5" d="{WORDMARK}"/>
</svg>''')
    return "\n".join(out)


def render(pulse: float):
    from PIL import Image
    png = subprocess.run(["rsvg-convert", "-w", str(SIZE), "-h", str(SIZE)], input=svg(pulse).encode(),
                         capture_output=True, check=True).stdout
    return Image.open(io.BytesIO(png)).convert("RGB")


def splash(path: str) -> None:
    from PIL import Image, ImageChops
    frames = [render((1 - math.cos(2 * math.pi * k / FRAMES)) / 2) for k in range(FRAMES)]
    # one palette for all: quantize them side by side
    strip = Image.new("RGB", (SIZE * FRAMES, SIZE))
    for k, f in enumerate(frames):
        strip.paste(f, (k * SIZE, 0))
    q = strip.quantize(256, dither=Image.Dither.NONE)
    palette = (q.getpalette() + [0] * 768)[:768]
    idx = [q.crop((k * SIZE, 0, (k + 1) * SIZE, SIZE)) for k in range(FRAMES)]
    # the rectangle that changes
    box = None
    for f in idx[1:]:
        b = ImageChops.difference(f.convert("L"), idx[0].convert("L")).getbbox()
        if b:
            box = b if box is None else (min(box[0], b[0]), min(box[1], b[1]), max(box[2], b[2]), max(box[3], b[3]))
    box = box or (0, 0, 1, 1)
    x, y, w, h = box[0], box[1], box[2] - box[0], box[3] - box[1]
    with open(path, "wb") as out:
        out.write(b"MSPL" + struct.pack("<8H", SIZE, SIZE, FRAMES, FRAME_MS, x, y, w, h))
        out.write(bytes(palette))
        out.write(idx[0].tobytes())
        for f in idx:
            out.write(f.crop(box).tobytes())
    print(f"make-splash: {path}: {FRAMES} frames, {w}x{h} at {x},{y} change")


def main() -> int:
    if len(sys.argv) == 3 and sys.argv[1] == "--svg":
        open(sys.argv[2], "w").write(svg(0.5, background=False) + "\n")
    elif len(sys.argv) == 3 and sys.argv[1] == "--splash":
        splash(sys.argv[2])
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
