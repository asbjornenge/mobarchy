#!/usr/bin/env python3
"""Mobarchy's logo (a circled M breaking out of its ring, Frigg's orb inside, the wordmark
under it) and the boot splash made from it: frames of the orb breathing, for
mobarchy-screenlog --splash (src/screenlog.c).

    make-splash --svg <file>       the logo, as one SVG (the orb at rest)
    make-splash --splash <file>    the splash: rendered with rsvg-convert, one palette

The splash file ("MSPL", little-endian): magic, u16 width, height, frames, frame ms, then
the rectangle that changes between frames (u16 x, y, w, h), a 256-colour palette (RGB),
the first frame whole (w*h bytes, palette indices), then each frame's rectangle.
Only the orb and its glow move; the rest is drawn once.
"""
import io
import math
import struct
import subprocess
import sys

SIZE = 560                 # px, square; the splash scales it by whole numbers
FRAMES = 32
FRAME_MS = 90              # ~2.9 s a breath
BG = "#000000"             # the panels are OLED; the bootloader's screen is black too
CX, CY, R = 256, 210, 112  # (the drawing's own 512 units)
WORDMARK = "m 118.03993,430 v -24.2 h 3.432 v 3.212 h 0.088 q 0.22,-1.628 1.276,-2.64 1.1,-1.012 2.772,-1.012 1.584,0 2.684,0.924 1.1,0.924 1.584,2.508 h 0.044 q 0.308,-1.584 1.364,-2.508 1.1,-0.924 2.772,-0.924 2.332,0 3.696,1.76 1.408,1.716 1.408,4.488 V 430 h -3.696 v -18.436 q 0,-1.452 -0.704,-2.288 -0.704,-0.88 -1.936,-0.88 -1.188,0 -1.892,0.836 -0.704,0.836 -0.704,2.288 V 430 h -3.256 v -18.436 q 0,-1.452 -0.704,-2.288 -0.704,-0.88 -1.892,-0.88 -1.232,0 -1.936,0.836 -0.704,0.836 -0.704,2.288 V 430 Z m 46.96002,0.352 q -4.356,0 -6.952,-2.552 -2.552,-2.552 -2.552,-7.128 v -5.544 q 0,-4.62 2.552,-7.128 2.552,-2.552 6.952,-2.552 4.4,0 6.952,2.552 2.552,2.508 2.552,7.128 v 5.544 q 0,4.576 -2.596,7.128 -2.552,2.552 -6.908,2.552 z m 0,-3.52 q 2.596,0 4.048,-1.452 1.496,-1.452 1.496,-4.268 v -6.424 q 0,-2.816 -1.496,-4.268 -1.452,-1.452 -4.048,-1.452 -2.552,0 -4.048,1.452 -1.496,1.452 -1.496,4.268 v 6.424 q 0,2.816 1.496,4.268 1.496,1.452 4.048,1.452 z m 37.80802,3.608 q -2.728,0 -4.488,-1.32 -1.76,-1.364 -2.068,-3.74 h -0.044 V 430 h -3.96 v -32.12 h 3.96 v 7.04 l -0.088,5.5 h 0.044 q 0.352,-2.332 2.112,-3.696 1.804,-1.364 4.532,-1.364 3.652,0 5.808,2.42 2.156,2.42 2.156,6.6 v 7.084 q 0,4.136 -2.156,6.556 -2.156,2.42 -5.808,2.42 z m -1.32,-3.432 q 2.508,0 3.916,-1.32 1.408,-1.32 1.408,-4.268 v -7.04 q 0,-2.992 -1.408,-4.268 -1.408,-1.32 -3.916,-1.32 -2.42,0 -3.872,1.54 -1.408,1.54 -1.408,4.268 v 6.6 q 0,2.728 1.408,4.268 1.452,1.54 3.872,1.54 z m 34.20001,3.432 q -3.74,0 -5.94,-2.068 -2.2,-2.112 -2.2,-5.5 0,-2.244 1.012,-3.916 1.012,-1.672 2.816,-2.596 1.804,-0.968 4.136,-0.968 h 7.48 V 413.5 q 0,-4.708 -5.148,-4.708 -2.288,0 -3.696,0.836 -1.408,0.836 -1.496,2.332 h -3.96 q 0.22,-2.86 2.64,-4.708 2.464,-1.892 6.512,-1.892 4.4,0 6.732,2.112 2.376,2.112 2.376,5.896 V 430 h -3.916 v -4.4 h -0.088 q -0.352,2.244 -2.244,3.564 -1.892,1.276 -5.016,1.276 z m 0.968,-3.344 q 2.904,0 4.62,-1.408 1.716,-1.408 1.716,-3.828 v -3.388 h -7.04 q -1.936,0 -3.168,1.188 -1.188,1.144 -1.