# Mobarchy kernel config fragment: what a regular Linux userspace needs on top of an
# Android (GKI) kernel. Device-agnostic; applied to every kernel_build (Kleaf
# --defconfig_fragment), including the GKI base kernel. See docs/decisions/0007.

# systemd / udev
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# SysV IPC: libhybris/Halium and plenty of Linux software
CONFIG_SYSVIPC=y

# Namespaces for sandboxing (flatpak, bubblewrap, containers)
CONFIG_USER_NS=y
CONFIG_PID_NS=y

# nftables (modern firewalling; iptables-nft)
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
# NAT with nftables, and the CHECKSUM target: containers' networks behind the phone
# (Waydroid's lxc-net script, ADR 0029)
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# Landlock (unprivileged sandboxing; e.g. pacman's download sandbox). Already first in
# the default CONFIG_LSM list.
CONFIG_SECURITY_LANDLOCK=y

# Usermode helpers. Android builds with a static, empty helper path, which disables them
# all: core dumps to systemd-coredump ("Core dump to |... disabled"), and the kernel's own
# requests for modules (request_module -> modprobe). A Linux userspace needs them.
# CONFIG_STATIC_USERMODEHELPER is not set
