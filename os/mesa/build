#!/usr/bin/env bash
# Build Mesa from a git checkout for an aarch64 Mobarchy device, as an Arch package that
# replaces the distribution's Mesa (provides/conflicts mesa, vulkan-panfrost).
#
#   os/mesa/build --src <mesa checkout> --out <dir> [--gallium panfrost,llvmpipe,softpipe]
#                 [--vulkan panfrost] [--jobs N] [--pkgrel N]
#
# Why: Arch's Mesa can lag behind what a GPU needs (comet's Mali-G715, Valhall v11, is
# only supported on Mesa main as of 2026-10; see ADR 0008). It replaces the system Mesa
# rather than sitting next to it: a side install needs LD_LIBRARY_PATH, which sandboxes
# (WebKit's bubblewrap) and services don't get. llvmpipe stays in, so software rendering
# keeps working when the GPU is not up.
#
# Builds natively in the arm64 Arch Linux ARM container (qemu-user), because Panfrost
# needs Mesa's own OpenCL compiler (mesa-clc, LLVM + libclc) at build time, which is far
# simpler native than cross. Result: <out>/mesa-mobarchy-<version>-<n>-aarch64.pkg.tar.zst
set -euo pipefail
src="" out="" gallium=panfrost,llvmpipe,softpipe vulkan=panfrost jobs=12 pkgrel=1
while [ $# -gt 0 ]; do
    case "$1" in
        --src) src="$(realpath "$2")"; shift 2 ;;
        --out) out="$(realpath -m "$2")"; shift 2 ;;
        --gallium) gallium="$2"; shift 2 ;;
        --vulkan) vulkan="$2"; shift 2 ;;
        --jobs) jobs="$2"; shift 2 ;;
        --pkgrel) pkgrel="$2"; shift 2 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done
[ -n "$src" ] && [ -n "$out" ] || { echo "usage: $0 --src <mesa checkout> --out <dir>" >&2; exit 2; }
[ -f "$src/meson.build" ] || { echo "$src is not a Mesa checkout" >&2; exit 1; }
mkdir -p "$out"
image=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep -m1 '^mobarchy-alarm-base:') || {
    echo "no mobarchy-alarm-base image: run os/image/build once" >&2; exit 1; }
rev=$(git -C "$src" rev-parse --short HEAD)
# Arch version: 26.3.0-devel at 185cc17 -> 26.3.0_devel.185cc17
pkgver="$(sed 's/-/_/g' "$src/VERSION").$rev"

docker run --rm --platform linux/arm64 -v "$src:/src:ro" -v "$out:/out" "$image" bash -euo pipefail -c "
    pacman-key --init >/dev/null 2>&1 && pacman-key --populate archlinuxarm >/dev/null 2>&1
    pacman -Syu --noconfirm --needed --disable-sandbox >/dev/null
    pacman -S --noconfirm --needed --disable-sandbox base-devel meson ninja python-mako \
        python-packaging python-yaml python-ply llvm clang libclc spirv-llvm-translator \
        spirv-tools spirv-headers glslang libdrm wayland wayland-protocols libelf zstd expat \
        libglvnd lm_sensors >/dev/null
    # The build tree lives in <out>/.build: a later failure (e.g. packaging) or rerun
    # doesn't cost a full rebuild (that is ~45 min under emulation).
    [ -f /out/.build/build.ninja ] || meson setup /out/.build /src --prefix=/usr --libdir=lib --sysconfdir=/etc \
        -Dbuildtype=release -Db_ndebug=true \
        -Dplatforms=wayland -Dgallium-drivers=$gallium -Dvulkan-drivers=$vulkan \
        -Dglx=disabled -Dgbm=enabled -Degl=enabled -Dgles1=disabled -Dgles2=enabled \
        -Dglvnd=enabled -Dllvm=enabled -Dshared-llvm=enabled -Dvalgrind=disabled \
        -Dlibunwind=disabled -Dvideo-codecs= -Dbuild-tests=false > /out/meson-setup.log
    ninja -C /out/.build -j$jobs > /out/ninja.log
    rm -rf /tmp/root && DESTDIR=/tmp/root ninja -C /out/.build install > /out/install.log

    # Package the installed tree with makepkg (as an unprivileged user).
    useradd -m builder 2>/dev/null || true
    mkdir -p /tmp/pkg && cp -a /tmp/root /tmp/pkg/root
    cat > /tmp/pkg/PKGBUILD <<'EOP'
pkgname=mesa-mobarchy
pkgver=PKGVER
pkgrel=PKGREL
pkgdesc='Mesa from git for Mobarchy devices (Panfrost GL/Vulkan, llvmpipe fallback)'
arch=(aarch64)
url='https://mesa3d.org'
license=(MIT)
# (libLLVM.so.<major>: another LLVM major leaves Mesa without its library, and the GPU
# without a driver; pacman stops at the conflict instead)
depends=(libdrm wayland expat zstd libglvnd 'llvm-libs>=LLVMMAJOR' 'llvm-libs<LLVMNEXT' spirv-tools
         lm_sensors libelf)
provides=(mesa=PKGVER opengl-driver vulkan-driver vulkan-panfrost=PKGVER libgbm.so)
conflicts=(mesa vulkan-panfrost vulkan-mesa-implicit-layers)
replaces=()
options=(!strip !debug)
package() { cp -a \"\$startdir/root/.\" \"\$pkgdir/\"; }
EOP
    llvm=\$(llvm-config --version | cut -d. -f1)
    sed -i \"s/PKGVER/$pkgver/g; s/PKGREL/$pkgrel/; s/LLVMMAJOR/\$llvm/; s/LLVMNEXT/\$((llvm + 1))/\" /tmp/pkg/PKGBUILD
    chown -R builder /tmp/pkg
    su builder -c 'cd /tmp/pkg && PKGDEST=/tmp/pkg PKGEXT=.pkg.tar.zst makepkg --nodeps --noconfirm >/tmp/pkg/makepkg.log 2>&1' \
        || { tail -20 /tmp/pkg/makepkg.log >&2; exit 1; }
    cp /tmp/pkg/mesa-mobarchy-*.pkg.tar.zst /out/
    chmod a+r /out/*
"
ls "$out"/mesa-mobarchy-*.pkg.tar.zst
