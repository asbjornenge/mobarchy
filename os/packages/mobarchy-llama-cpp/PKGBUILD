# llama.cpp's server for the local agent (ADR 0010), under /opt/mobarchy/llama.
# Statically linked, for ARMv8.6 with dotprod and i8mm (Q4_0 prompts ~1.7x faster on comet).
# Not ggml's runtime CPU variants (GGML_CPU_ALL_VARIANTS): on Linux every variant from
# ARMv8.2 up uses SVE, which is slower than NEON on phone cores (whisper small: 3.0 s
# encode instead of 2.0 s on comet); ggml keeps SVE-free variants for Android only.
# Revisit with a device older than ARMv8.6. Build: tools/repo-build mobarchy-llama-cpp

pkgname=mobarchy-llama-cpp
_commit=254b177307b14d055bbe4c050c9c441a1e06d8a4
pkgver=0+254b177
pkgrel=3
pkgdesc="llama.cpp's server for Mobarchy's local agent"
arch=(aarch64)
url='https://github.com/ggml-org/llama.cpp'
license=(MIT)
depends=(gcc-libs glibc)
makedepends=(cmake git)
options=(!debug)
source=("llama.cpp::git+$url#commit=$_commit")
sha256sums=('SKIP')
_prefix=/opt/mobarchy/llama

build() {
    cmake -S llama.cpp -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$_prefix \
        -DGGML_NATIVE=OFF -DGGML_CPU_ARM_ARCH=armv8.6-a+dotprod+i8mm \
        -DBUILD_SHARED_LIBS=OFF -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF \
        -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=ON -DLLAMA_BUILD_TOOLS=ON
    # Bounded: unbounded parallel C++ jobs run a phone out of memory.
    cmake --build build --parallel "$(( $(nproc) < 6 ? $(nproc) : 6 ))"
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    # Only the server is used; the CLI tools stay in the prefix.
    install -d "$pkgdir/usr/bin"
    ln -s $_prefix/bin/llama-server "$pkgdir/usr/bin/llama-server"
    install -Dm644 llama.cpp/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
