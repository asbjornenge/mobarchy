# whisper.cpp's command line for speech to text on the phone (mobarchy-agent transcribe),
# under /opt/mobarchy/whisper. Statically linked for ARMv8.6 with dotprod and i8mm, for the
# same reason as mobarchy-llama-cpp (no SVE: slower on phone cores).
# Build: tools/repo-build mobarchy-whisper-cpp

pkgname=mobarchy-whisper-cpp
_commit=60c0be6ac8fa71b1a2ae2dd938a31a34a508e774
pkgver=0+60c0be6
pkgrel=3
pkgdesc="whisper.cpp's speech to text for Mobarchy"
arch=(aarch64)
url='https://github.com/ggml-org/whisper.cpp'
license=(MIT)
depends=(gcc-libs glibc)
makedepends=(cmake git)
options=(!debug)
source=("whisper.cpp::git+$url#commit=$_commit")
sha256sums=('SKIP')
_prefix=/opt/mobarchy/whisper

build() {
    cmake -S whisper.cpp -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$_prefix \
        -DGGML_NATIVE=OFF -DGGML_CPU_ARM_ARCH=armv8.6-a+dotprod+i8mm \
        -DBUILD_SHARED_LIBS=OFF -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_EXAMPLES=ON \
        -DWHISPER_BUILD_SERVER=OFF
    # Bounded: unbounded parallel C++ jobs run a phone out of memory.
    cmake --build build --parallel "$(( $(nproc) < 6 ? $(nproc) : 6 ))"
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm755 build/bin/whisper-cli "$pkgdir$_prefix/bin/whisper-cli"
    install -d "$pkgdir/usr/bin"
    ln -s $_prefix/bin/whisper-cli "$pkgdir/usr/bin/whisper-cli"
    install -Dm644 whisper.cpp/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
