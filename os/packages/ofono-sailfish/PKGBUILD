# oFono, Sailfish OS's branch: the telephony daemon (modems, SIM, SMS, calls, data) with
# the "slot" API that the binder plugin (Android's radio HAL) needs (ADR 0014). Upstream
# oFono doesn't have it. Pinned to a commit: the branch has no release tags.
# Build: tools/pkg-build ofono-sailfish

pkgname=ofono-sailfish
_commit=c89e86786a5526232286c1129e16948693fc0686
pkgver=1.29+git20260827
pkgrel=1
pkgdesc='Telephony daemon (Sailfish OS branch of oFono)'
arch=(x86_64 aarch64)
url='https://github.com/sailfishos/ofono'
license=(GPL-2.0-only)
depends=(glib2 dbus libglibutil systemd-libs mobile-broadband-provider-info)
makedepends=(git dbus-glib)
provides=(ofono)
conflicts=(ofono)
source=("git+$url.git#commit=$_commit")
sha256sums=('SKIP')

prepare() {
	cd ofono/ofono
	autoreconf --force --install
}

build() {
	cd ofono/ofono
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
		--sbindir=/usr/bin --libexecdir=/usr/lib \
		--disable-static \
		--disable-rilmodem --disable-isimodem --disable-qmimodem \
		--disable-bluetooth --disable-upower \
		--with-systemdunitdir=/usr/lib/systemd/system
	make
}

package() {
	cd ofono/ofono
	make DESTDIR="$pkgdir" install
	install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
