# Arch's spotify-player PKGBUILD (maintainer: Orhun Parmaksız <orhun@archlinux.org>), as
# Arch Linux ARM builds it, plus Mobarchy's patch: a custom client_id with
# ncspot_only_get_endpoints = [] signs in once, without the ncspot fallback client and its
# second OAuth approval (see the patch). Drop this package once upstream does that.
#
# Built on a PC, cross-compiled (cargo under qemu-user takes too long):
#   ./cross-build --work <dir> [--repo <dir>]   (tools/cross-cargo)
# A native aarch64 build with plain makepkg also works.

pkgname=spotify-player
pkgver=0.25.1
pkgrel=1.1
pkgdesc="A command driven spotify player"
arch=('x86_64' 'aarch64')
url="https://github.com/aome510/spotify-player"
license=('MIT')
depends=('openssl' 'dbus' 'libpulse' 'libsixel')
optdepends=('libnotify: Notification support' 'fzf: Fuzzy search support')
makedepends=('cargo')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/aome510/spotify-player/archive/v${pkgver}.tar.gz"
        0001-no-ncspot-fallback-without-its-endpoints.patch)
sha512sums=('67d1e3afc0d3bf4b22567ee12d4e411ded1c3827d5e84414e7f0f47529aa2ddb38fee81a099eefbac0ba51dfb09ce4103adce8073918193c0231b61cbf15451b'
            'ff7061c46f51e73e23bf5b8a40f9f2df86a7c4e34273db2ad08c92c4c8d69c14313f8989f2e0d120c52705c01bf67b188c913647de7cdb85a7d1d61824eda546')
options=('!lto')

prepare() {
  cd "${pkgname}-${pkgver}"
  patch -Np1 -i ../0001-no-ncspot-fallback-without-its-endpoints.patch
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  local _features=('pulseaudio-backend' 'media-control' 'notify' 'daemon' 'image' 'sixel' 'fzf')
  cd "${pkgname}-${pkgver}"
  cargo build --frozen --release --bin spotify_player --no-default-features --features "${_features[*]}"
}

check() {
  cd "${pkgname}-${pkgver}"
  cargo test --frozen
}

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm755 target/release/spotify_player -t "${pkgdir}/usr/bin"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

# vim:set ts=2 sw=2 et:
