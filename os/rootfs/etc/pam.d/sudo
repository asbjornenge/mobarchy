#%PAM-1.0
# sudo asks the owner (ADR 0022): over ssh (a key login: the developer's access) it doesn't;
# on the phone, a finger on the sensor (pam_fprintd, against fprintd's interface:
# mobarchy-fingerprint on comet; it steps aside without a sensor or an enrolled finger), or
# the PIN (the owner's password).
auth		sufficient	pam_exec.so quiet /usr/lib/mobarchy/sudo-remote
auth		sufficient	pam_fprintd.so
auth		include		system-auth
account		include		system-auth
session		include		system-auth
session		optional	pam_systemd.so class=none
