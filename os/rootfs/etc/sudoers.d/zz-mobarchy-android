# Android (ADR 0029): the owner's session gives Android where the phone is, and sets it up
# once it has booted, through these helpers (the first takes numbers only, the second nothing), without asking for
# the PIN each time. (Named to come after the wheel rule: the last rule that matches wins.)
%wheel ALL=(root) NOPASSWD: /usr/lib/mobarchy/android-location-set
%wheel ALL=(root) NOPASSWD: /usr/lib/mobarchy/android-setup ""
