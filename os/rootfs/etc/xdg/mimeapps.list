# Mobarchy defaults. Users override them in ~/.config/mimeapps.list.
[Default Applications]
text/html=org.mobarchy.Browser.desktop;firefox.desktop
x-scheme-handler/http=org.mobarchy.Browser.desktop;firefox.desktop
x-scheme-handler/https=org.mobarchy.Browser.desktop;firefox.desktop
x-scheme-handler/about=firefox.desktop
application/xhtml+xml=org.mobarchy.Browser.desktop;firefox.desktop
