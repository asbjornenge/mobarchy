#!/bin/sh
# Android, on demand (ADR 0029): starts the Waydroid session if it isn't running, shows its
# full UI in a window, and stops the session again when that window is closed. Off by
# default, so Android costs nothing (it holds ~2.5 GB while running) until the owner opens
# it from the app drawer (org.mobarchy.Android.desktop).
set -eu

export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

session() { waydroid status 2>/dev/null | awk -F'\t' '/^Session:/ {print $NF}'; }

if [ "$(session)" != "RUNNING" ]; then
    systemctl --user reset-failed waydroid-session 2>/dev/null || true
    systemd-run --user --quiet --collect --unit=waydroid-session waydroid session start
    # let the session come up before the UI connects (show-full-ui then shows the boot screen)
    i=0
    while [ "$(session)" != "RUNNING" ] && [ "$i" -lt 30 ]; do
        sleep 1; i=$((i + 1))
    done
fi

# where the phone is, for Android's apps (while the session is up)
systemctl --user reset-failed mobarchy-android-location 2>/dev/null || true
systemd-run --user --quiet --collect --unit=mobarchy-android-location /usr/lib/mobarchy/android-location || true

# The UI window. `waydroid show-full-ui` only asks Android to show it and returns (it
# waits for Android to be up, at a cold start); the window is Android's own surface
# ("Waydroid"). So: wait for that window (up to three minutes: a cold start), then follow it
# until the owner has closed it.
waydroid show-full-ui || true
windows() { hyprctl -j clients 2>/dev/null | jq '[.[] | select(.class == "Waydroid" or .initialClass == "Waydroid")] | length'; }
i=0
while [ "$(windows)" = "0" ] && [ "$i" -lt 90 ] && [ "$(session)" = "RUNNING" ]; do
    sleep 2; i=$((i + 1))
done
while [ "$(windows)" != "0" ] && [ "$(session)" = "RUNNING" ]; do
    sleep 3
done

# closed: free the memory
systemctl --user stop mobarchy-android-location 2>/dev/null || true
waydroid session stop 2>/dev/null || true
