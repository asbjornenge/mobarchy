#!/usr/bin/env python3
"""Where the phone is, for Android's apps (ADR 0029): Waydroid has no location of its own,
so this gives it the phone's (GeoClue: the GPS, or Wi-Fi nearby; ADR 0033) as Android's
"gps" provider. Run by mobarchy-android while the Android session is up.

Through adb (Waydroid's adbd on its own network): a test provider, `cmd location providers
set-test-provider-location`. Android marks such fixes as from a test provider; an app that
refuses those, refuses.

    android-location        (until stopped)
"""
import subprocess
import sys
import time

from gi.repository import Gio, GLib

GEOCLUE = "org.freedesktop.GeoClue2"
EXACT = 8
PROVIDER = "gps"


def log(msg: str) -> None:
    print(f"android-location: {msg}", flush=True)


def android_ip() -> str:
    out = subprocess.run(["waydroid", "status"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.startswith("IP address:"):
            return line.split(":", 1)[1].strip()
    return ""


class Android:
    def __init__(self):
        self.serial = ""

    def adb(self, *args: str) -> bool:
        r = subprocess.run(["adb", "-s", self.serial, "shell", *args], capture_output=True, text=True, timeout=20)
        if r.returncode != 0 or "Exception" in r.stdout + r.stderr:
            log(f"{' '.join(args)}: {(r.stdout + r.stderr).strip()[:200]}")
            return False
        return True

    def connect(self) -> bool:
        ip = android_ip()
        if not ip:
            return False
        self.serial = f"{ip}:5555"
        r = subprocess.run(["adb", "connect", self.serial], capture_output=True, text=True, timeout=20)
        if "connected" not in r.stdout:
            return False
        # (the shell may set test providers)
        self.adb("appops", "set", "com.android.shell", "android:mock_location", "allow")
        self.adb("cmd", "location", "set-location-enabled", "true")
        self.adb("cmd", "location", "providers", "add-test-provider", PROVIDER)
        return self.adb("cmd", "location", "providers", "set-test-provider-enabled", PROVIDER, "true")

    def tell(self, lat: float, lon: float, accuracy: float) -> bool:
        return self.adb("cmd", "location", "providers", "set-test-provider-location", PROVIDER,
                        "--location", f"{lat},{lon}", "--accuracy", f"{max(1.0, accuracy):.0f}")


def main() -> int:
    android = Android()
    for _ in range(60):     # (Android is still booting, at first)
        if android.connect():
            break
        time.sleep(5)
    else:
        log("Android did not answer on adb")
        return 1
    log(f"Android at {android.serial}")

    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)

    def call(path, iface, method, args=None, sig=None):
        return bus.call_sync(GEOCLUE, path, iface, method, GLib.Variant(sig, args) if sig else None,
                             None, Gio.DBusCallFlags.NONE, 30000, None).unpack()

    def setp(path, name, value):
        bus.call_sync(GEOCLUE, path, "org.freedesktop.DBus.Properties", "Set",
                      GLib.Variant("(ssv)", ("org.freedesktop.GeoClue2.Client", name, value)),
                      None, Gio.DBusCallFlags.NONE, 30000, None)

    (client,) = call("/org/freedesktop/GeoClue2/Manager", "org.freedesktop.GeoClue2.Manager", "CreateClient")
    setp(client, "DesktopId", GLib.Variant("s", "org.mobarchy.Android"))
    setp(client, "RequestedAccuracyLevel", GLib.Variant("u", EXACT))
    setp(client, "TimeThreshold", GLib.Variant("u", 2))

    def updated(_bus, _sender, _path, _iface, _signal, params, _data):
        new = params.unpack()[1]
        props = bus.call_sync(GEOCLUE, new, "org.freedesktop.DBus.Properties", "GetAll",
                              GLib.Variant("(s)", ("org.freedesktop.GeoClue2.Location",)),
                              None, Gio.DBusCallFlags.NONE, 10000, None).unpack()[0]
        if android.tell(props["Latitude"], props["Longitude"], props["Accuracy"]):
            log(f"{props['Latitude']:.5f},{props['Longitude']:.5f} ±{props['Accuracy']:.0f} m")

    bus.signal_subscribe(GEOCLUE, "org.freedesktop.GeoClue2.Client", "LocationUpdated", client, None,
                         Gio.DBusSignalFlags.NONE, updated, None)
    call(client, "org.freedesktop.GeoClue2.Client", "Start")
    loop = GLib.MainLoop()
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, 15, loop.quit)
    loop.run()
    try:
        call(client, "org.freedesktop.GeoClue2.Client", "Stop")
        android.adb("cmd", "location", "providers", "remove-test-provider", PROVIDER)
    except GLib.Error:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
