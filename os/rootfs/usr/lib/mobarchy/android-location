#!/usr/bin/env python3
"""Where the phone is, for Android's apps (ADR 0029): Waydroid has no location of its own,
so this gives it the phone's (GeoClue: the GPS, or Wi-Fi nearby; ADR 0033) as Android's
"gps" provider. Run by mobarchy-android while the Android session is up.

Android takes it as a test provider (`cmd location providers ...`, through
android-location-set, root's half): it marks those fixes as such, and an app that refuses
them, refuses.

    android-location        (until stopped)
"""
import subprocess
import sys
import time

from gi.repository import Gio, GLib

GEOCLUE = "org.freedesktop.GeoClue2"
EXACT = 8
HELPER = "/usr/lib/mobarchy/android-location-set"
EVERY_S = 3         # (each one starts a shell in the container: not more often)


def log(msg: str) -> None:
    print(f"android-location: {msg}", flush=True)


def helper(*args: str) -> bool:
    r = subprocess.run(["sudo", "-n", HELPER, *args], capture_output=True, text=True, timeout=30)
    if r.returncode != 0 or "Exception" in r.stdout:
        log(f"{' '.join(args)}: {(r.stdout + r.stderr).strip()[:300]}")
        return False
    return True


def main() -> int:
    for _ in range(60):     # (Android is still booting, at first)
        if helper("start"):
            break
        time.sleep(5)
    else:
        log("Android did not take the provider")
        return 1

    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)

    def call(path, iface, method, args=None, sig=None):
        return bus.call_sync(GEOCLUE, path, iface, method, GLib.Variant(sig, args) if sig else None,
                             None, Gio.DBusCallFlags.NONE, 30000, None).unpack()

    def setp(path, name, value):
        bus.call_sync(GEOCLUE, path, "org.freedesktop.DBus.Properties", "Set",
                      GLib.Variant("(ssv)", ("org.freedesktop.GeoClue2.Client", name, value)),
                      None, Gio.DBusCallFlags.NONE, 30000, None)

    (client,) = call("/org/freedesktop/GeoClue2/Manager", "org.freedesktop.GeoClue2.Manager", "CreateClient")
    setp(client, "DesktopId", GLib.Variant("s", "org.mobarchy.Android"))
    setp(client, "RequestedAccuracyLevel", GLib.Variant("u", EXACT))
    setp(client, "TimeThreshold", GLib.Variant("u", EVERY_S))

    last = [0.0]

    def updated(_bus, _sender, _path, _iface, _signal, params, _data):
        if time.monotonic() - last[0] < EVERY_S:
            return
        last[0] = time.monotonic()
        p = bus.call_sync(GEOCLUE, params.unpack()[1], "org.freedesktop.DBus.Properties", "GetAll",
                          GLib.Variant("(s)", ("org.freedesktop.GeoClue2.Location",)),
                          None, Gio.DBusCallFlags.NONE, 10000, None).unpack()[0]
        if helper(f"{p['Latitude']:.6f}", f"{p['Longitude']:.6f}", f"{max(1.0, p['Accuracy']):.0f}"):
            log(f"{p['Latitude']:.5f},{p['Longitude']:.5f} ±{p['Accuracy']:.0f} m")

    bus.signal_subscribe(GEOCLUE, "org.freedesktop.GeoClue2.Client", "LocationUpdated", client, None,
                         Gio.DBusSignalFlags.NONE, updated, None)
    call(client, "org.freedesktop.GeoClue2.Client", "Start")
    log("started")
    loop = GLib.MainLoop()
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, 15, loop.quit)
    loop.run()
    try:
        call(client, "org.freedesktop.GeoClue2.Client", "Stop")
    except GLib.Error:
        pass
    helper("stop")
    return 0


if __name__ == "__main__":
    sys.exit(main())
