#!/bin/sh
# End the boot splash (Mobarchy's logo, left running by the initramfs across switch_root) so
# the session can take the display: run as root before mobarchy-session starts. Waits for it
# to be gone (it holds the display as DRM master until then). Nothing to do on later starts.
pidfile=/run/mobarchy-splash.pid
[ -f "$pidfile" ] || exit 0
pid=$(cat "$pidfile")
rm -f "$pidfile"
case "$(cat /proc/"$pid"/comm 2>/dev/null)" in
mobarchy-screen*) ;;
*) exit 0 ;;
esac
kill "$pid" 2>/dev/null
i=0
while [ -d /proc/"$pid" ] && [ "$i" -lt 40 ]; do sleep 0.05; i=$((i + 1)); done
[ -d /proc/"$pid" ] && kill -9 "$pid" 2>/dev/null
exit 0
