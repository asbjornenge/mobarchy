#!/usr/bin/env python3
"""Prepares Waydroid (the Android apps' container, ADR 0029) before its container starts
(waydroid-container.service's ExecStartPre):

  - binder devices of its own (anbox-binder, anbox-vndbinder, anbox-hwbinder) in a binderfs
    instance of its own: /dev/binder etc. are the Android container's (ADR 0014), and the two
    must not share a context manager
  - the GPU's render node for its gralloc and Mesa (drm_device): the one whose driver is a
    GPU's, not the display controller's (which has no 3D); Waydroid's own pick is the first
    render node, which on a phone is often the display's
  - Waydroid's config to match; its Android properties are regenerated (waydroid upgrade
    --offline) only when something changed
  - the vendor image's HAL manifest without HALs it declares but doesn't have (overlaid):
    its OMX codec HAL has no service, and Android waits for a declared HAL for ever, so
    the media server hung, and with it the shared storage (/storage/emulated) and whatever
    waits on that
  - then the codecs Android has, its own Codec2 software ones (debug.stagefright.ccodec=4):
    Waydroid sets 0, OMX only, for the OMX (ffmpeg) codecs the image lacks; without codecs no
    video played and no sound (apps decode it)
  - the lxc-net script for a kernel without nftables NAT and the CHECKSUM target: Waydroid's
    default uses nftables masquerade (CONFIG_NFT_NAT/NFT_MASQ) and the xt CHECKSUM target,
    neither of which the comet kernel has yet (they are in mobarchy_defconfig, pending a
    kernel flash). It is forced onto iptables (which has NAT here) and the CHECKSUM rule is
    made non-fatal. A waydroid/pacman upgrade overwrites the script, so this reapplies it.
    (iptables NAT works on a NAT-capable kernel too, so this stays safe once the kernel has
    the nft options; drop it then if nftables is wanted.)

Idempotent: run as often as the container starts.
"""

import configparser
import fcntl
import os
import re
import struct
import subprocess
import sys
import tempfile
from pathlib import Path

BINDERFS = Path("/run/waydroid-binderfs")
BINDERS = {"binder": "anbox-binder", "vndbinder": "anbox-vndbinder", "hwbinder": "anbox-hwbinder"}
# _IOWR('b', 1, struct binderfs_device { char name[256]; __u32 major, minor; })
BINDER_CTL_ADD = (3 << 30) | (264 << 16) | (ord("b") << 8) | 1
CFG = Path("/var/lib/waydroid/waydroid.cfg")
OVERLAY = Path("/var/lib/waydroid/overlay")
MANIFEST = "etc/vintf/manifest.xml"
# HALs a vendor image may declare without a service, and the binary that would serve them
SERVED_BY = {"android.hardware.media.omx": "bin/hw/android.hardware.media.omx@1.0-service"}
NET_SCRIPT = Path("/usr/lib/waydroid/data/scripts/waydroid-net.sh")
# DRM drivers that render (Mesa has a driver for them); display-only ones are left out
GPU_DRIVERS = {"panthor", "panfrost", "lima", "msm", "v3d", "vc4", "etnaviv", "asahi",
               "amdgpu", "radeon", "i915", "xe", "nouveau", "virtio_gpu", "powervr"}


def binders() -> None:
    BINDERFS.mkdir(parents=True, exist_ok=True)
    if not os.path.ismount(BINDERFS):
        subprocess.run(["mount", "-t", "binder", "binder", str(BINDERFS)], check=True)
    for name in BINDERS.values():
        path = BINDERFS / name
        if not path.exists():
            fd = os.open(BINDERFS / "binder-control", os.O_RDONLY)
            try:
                fcntl.ioctl(fd, BINDER_CTL_ADD, struct.pack("256sII", name.encode(), 0, 0))
            finally:
                os.close(fd)
        path.chmod(0o666)
        link = Path("/dev") / name
        if link.is_symlink() or link.exists():
            if link.is_symlink() and os.readlink(link) == str(path):
                continue
            link.unlink()
        link.symlink_to(path)


def gpu_render_node() -> str | None:
    for node in sorted(Path("/sys/class/drm").glob("renderD*")):
        driver = node / "device" / "driver"
        if driver.exists() and driver.resolve().name in GPU_DRIVERS:
            return f"/dev/dri/{node.name}"
    return None


def configure(missing: list[str]) -> bool:
    """Waydroid's config to match; True if it changed."""
    if not CFG.exists():
        return False     # not initialised yet (waydroid init): nothing to match
    cfg = configparser.ConfigParser()
    cfg.read(CFG)
    w = cfg["waydroid"]
    want = dict(BINDERS)
    if node := gpu_render_node():
        want["drm_device"] = node
    changed = {k: v for k, v in want.items() if w.get(k) != v}
    # without the OMX codecs: Android's own Codec2 ones (Waydroid's default is OMX only)
    props = cfg["properties"] if cfg.has_section("properties") else None
    if props is None:
        cfg.add_section("properties")
        props = cfg["properties"]
    ccodec = "4" if "android.hardware.media.omx" in missing else None
    if props.get("debug.stagefright.ccodec") != ccodec:
        changed["debug.stagefright.ccodec"] = ccodec
    if not changed:
        return False
    for k, v in changed.items():
        if k == "debug.stagefright.ccodec":
            if v is None:
                props.pop(k, None)
            else:
                props[k] = v
        else:
            w[k] = v
    with CFG.open("w") as f:
        cfg.write(f)
    print(f"waydroid-prepare: {changed}")
    return True


def vendor_manifest() -> list[str]:
    """The vendor image's manifest, less the HALs it lacks, in the overlay (or none). The
    HALs it lacks."""
    if not CFG.exists():
        return []
    cfg = configparser.ConfigParser()
    cfg.read(CFG)
    image = Path(cfg["waydroid"].get("images_path", "/var/lib/waydroid/images")) / "vendor.img"
    if not image.exists():
        return []
    with tempfile.TemporaryDirectory() as mnt:
        subprocess.run(["mount", "-o", "ro,loop", str(image), mnt], check=True)
        try:
            manifest = (Path(mnt) / MANIFEST).read_text()
            missing = [hal for hal, binary in SERVED_BY.items() if not (Path(mnt) / binary).exists()]
        finally:
            subprocess.run(["umount", mnt], check=True)
    for hal in missing:
        manifest = re.sub(rf'\s*<hal format="hidl">\s*<name>{re.escape(hal)}</name>.*?</hal>', "",
                          manifest, flags=re.S)
    target = OVERLAY / "vendor" / MANIFEST
    if missing:
        if not target.exists() or target.read_text() != manifest:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(manifest)
            print(f"waydroid-prepare: vendor manifest without {missing}")
    elif target.exists():
        target.unlink()
    return missing


def net_script() -> None:
    """Force iptables and a non-fatal CHECKSUM rule (this kernel lacks nft NAT / xt CHECKSUM)."""
    if not NET_SCRIPT.exists():
        return
    text = original = NET_SCRIPT.read_text()
    text = text.replace('LXC_USE_NFT="true"', 'LXC_USE_NFT="false"')
    # append "|| true" to any CHECKSUM rule that doesn't already have it
    text = re.sub(r'(-j CHECKSUM --checksum-fill)(?!.*\|\| true)([ \t]*)$',
                  r'\1 || true', text, flags=re.M)
    if text != original:
        NET_SCRIPT.write_text(text)
        print("waydroid-prepare: patched waydroid-net.sh (iptables, CHECKSUM non-fatal)")


def main() -> int:
    binders()
    missing = vendor_manifest()
    net_script()
    if configure(missing):
        # the Android properties (gralloc's device among them) and the LXC config from it
        subprocess.run(["waydroid", "upgrade", "--offline"], check=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
