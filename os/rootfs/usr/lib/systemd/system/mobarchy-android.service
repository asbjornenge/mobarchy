[Unit]
Description=Android container: the vendor's own services (modem, thermal; ADRs 0014, 0015)
ConditionPathExists=/etc/mobarchy/device.toml
After=local-fs.target systemd-sysusers.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
ExecCondition=/usr/lib/mobarchy/android-container check
ExecStartPre=/usr/lib/mobarchy/android-container prepare
ExecStart=/usr/lib/mobarchy/android-container run
# while lxc-start still runs, so lxc-stop can reach the container; again after, to clean up
ExecStop=/usr/lib/mobarchy/android-container stop
ExecStopPost=/usr/lib/mobarchy/android-container stop
# lxc-start -F returns when the container has stopped
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
