[Unit]
Description=Mobarchy session (Hyprland for the owner on seat0)
# Phones have no VTs (CONFIG_VT is off in Android kernels), so there is no getty to log
# in on; the session is a service with a PAM login session on seat0 instead.
After=systemd-user-sessions.service systemd-logind.service
Conflicts=getty@tty1.service

[Service]
User=mob
PAMName=login
WorkingDirectory=~
Environment=XDG_SEAT=seat0 XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_SESSION_DESKTOP=Hyprland
# Device-specific environment: /etc/mobarchy/session.env and /run/mobarchy/session.env,
# read by the session script (see there).
# pam_systemd puts CAP_WAKE_ALARM in the session's ambient set, and every app inherits it.
# bubblewrap refuses to run with capabilities it didn't get from setuid, which breaks
# glycin (GTK's image loader: no SVG icons) and other sandboxed apps. Drop it.
ExecStart=/usr/bin/setpriv --inh-caps=-all --ambient-caps=-all /usr/lib/mobarchy/session
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
