[Unit]
Description=Mobarchy session (Hyprland for the owner on seat0)
# Phones have no VTs (CONFIG_VT is off in Android kernels), so there is no getty to log
# in on; the session is a service with a PAM login session on seat0 instead.
After=systemd-user-sessions.service systemd-logind.service
Conflicts=getty@tty1.service

[Service]
User=mob
PAMName=login
WorkingDirectory=~
Environment=XDG_SEAT=seat0 XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_SESSION_DESKTOP=Hyprland
# Device-specific settings (e.g. Mesa software rendering on GPU-less KMS devices).
EnvironmentFile=-/etc/mobarchy/session.env
ExecStart=/usr/bin/start-hyprland
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
