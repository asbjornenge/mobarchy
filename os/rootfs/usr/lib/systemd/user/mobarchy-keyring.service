[Unit]
Description=Default keyring without a password prompt (see /usr/lib/mobarchy/keyring-setup)
After=gnome-keyring-daemon.socket
Requires=gnome-keyring-daemon.socket

[Service]
# Essential to the session, not an app: out of app.slice, where systemd-oomd picks what
# to kill (ADR 0035).
Slice=session.slice
Type=oneshot
ExecStart=/usr/lib/mobarchy/keyring-setup
