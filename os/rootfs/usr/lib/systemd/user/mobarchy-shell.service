[Unit]
Description=Mobarchy shell (status bar, app drawer, agent home)
PartOf=graphical-session.target
After=mobarchy-mcp.service
# The shell is the phone's whole UI (and it turns the screen back on when it starts):
# keep restarting it.
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
# Essential to the session, not an app: out of app.slice, where systemd-oomd picks what
# to kill (ADR 0035).
Slice=session.slice
ExecStart=/usr/bin/mobarchy-shell
Restart=always
RestartSec=1
