[Unit]
Description=Spotify on the phone (spotify-player: a Spotify Connect device, with MPRIS)
# Started by the Spotify app (signing in too: without credentials it opens Spotify's pages
# in the browser and keeps what it gets); it stays up so that Spotify plays on with the
# app closed and the phone shows as a device in Spotify's other apps.
After=pipewire-pulse.service

[Service]
# (-d: it forks, the parent goes; the child is the service)
Type=forking
# The owner's own Spotify app (developer.spotify.com: its client ID, not secret but the
# owner's, so outside the image): SPOTIFY_CLIENT_ID in ~/.config/mobarchy/spotify.env.
# Without it, spotify-player's shared one (ncspot's), which is often at Spotify's rate limit.
EnvironmentFile=-%h/.config/mobarchy/spotify.env
# its sign-in pages go to the app (/usr/lib/mobarchy/spotify-signin/xdg-open)
Environment=PATH=/usr/lib/mobarchy/spotify-signin:/usr/local/bin:/usr/bin
ExecStart=/bin/sh -c 'exec /usr/bin/spotify_player -c /usr/share/mobarchy/spotify-player $${SPOTIFY_CLIENT_ID:+-o client_id=$$SPOTIFY_CLIENT_ID} -d'
Restart=on-failure
RestartSec=5
Slice=app.slice

[Install]
WantedBy=default.target
