# Mobarchy's Spotify service (a Spotify Connect device on librespot, with D-Bus and MPRIS),
# built from this directory.
#
# Built on a PC, cross-compiled (cargo under qemu-user takes too long):
#   ./cross-build --work <dir> [--repo <dir>]   (tools/cross-cargo)
# A native build also works: BUILDDIR=/tmp/makepkg makepkg

pkgname=mobarchy-spotify
pkgver=0.1.0
pkgrel=1
pkgdesc="Mobarchy's Spotify service: a Spotify Connect device on librespot, with D-Bus and MPRIS"
arch=(aarch64 x86_64)
depends=(libpulse openssl gcc-libs glibc)
makedepends=(cargo)
options=(!lto !debug)

prepare() {
    # the sources, from here (target/ left behind)
    rm -rf "$srcdir/$pkgname"
    mkdir -p "$srcdir/$pkgname"
    cp -r "$startdir"/{Cargo.toml,Cargo.lock,src} "$srcdir/$pkgname/"
    cd "$srcdir/$pkgname"
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "$srcdir/$pkgname"
    cargo build --frozen --release
}

check() {
    cd "$srcdir/$pkgname"
    cargo test --frozen
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 target/release/mobarchy-spotify -t "$pkgdir/usr/bin"
    install -Dm644 "$startdir/mobarchy-spotify.service" -t "$pkgdir/usr/lib/systemd/user"
}
