#!/usr/bin/env python3
"""mobsim: run and drive the Mobarchy simulator (a QEMU/KVM VM).

Built for agents as much as for humans. Every command is non-interactive,
prints plain text or JSON, and exits non-zero on failure.

State (disk images, sockets, logs) is kept outside the repo in
$MOBARCHY_SIM_DIR (default ~/.cache/mobarchy/sim).
"""

from __future__ import annotations

import argparse
import json
import os
import resource
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DEVICE = REPO / "devices" / "sim-x86_64" / "device.toml"
STATE = Path(os.environ.get("MOBARCHY_SIM_DIR", Path.home() / ".cache" / "mobarchy" / "sim"))

BASE_IMAGE_URL = "https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2"
BASE_IMAGE = STATE / "arch-cloudimg.qcow2"
DISK = STATE / "disk.qcow2"
SEED = STATE / "seed.iso"
SSH_KEY = STATE / "id_ed25519"
QMP_SOCK = STATE / "qmp.sock"
PIDFILE = STATE / "qemu.pid"
SERIAL_LOG = STATE / "serial.log"
OVMF_CODE = Path("/usr/share/OVMF/OVMF_CODE_4M.fd")
OVMF_VARS_TEMPLATE = Path("/usr/share/OVMF/OVMF_VARS_4M.fd")
OVMF_VARS = STATE / "OVMF_VARS.fd"

GUEST_USER = "mob"
ABS_MAX = 0x7FFF  # QEMU's absolute input axis range is 0..0x7fff


def die(msg: str, code: int = 1) -> None:
    print(f"mobsim: {msg}", file=sys.stderr)
    sys.exit(code)


def load_device() -> dict:
    with DEVICE.open("rb") as f:
        return tomllib.load(f)


def main_display(dev: dict) -> dict:
    return dev["display"][0]


# --- QMP --------------------------------------------------------------------


class QMP:
    def __init__(self, path: Path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(30)
        self.sock.connect(str(path))
        self.buf = b""
        self._read()  # greeting
        self.cmd("qmp_capabilities")

    def _read(self) -> dict:
        while b"\n" not in self.buf:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("QMP socket closed")
            self.buf += chunk
        line, self.buf = self.buf.split(b"\n", 1)
        return json.loads(line)

    def cmd(self, name: str, **args) -> object:
        msg = {"execute": name}
        if args:
            msg["arguments"] = args
        self.sock.sendall(json.dumps(msg).encode() + b"\n")
        while True:
            resp = self._read()
            if "event" in resp:
                continue
            if "error" in resp:
                raise RuntimeError(f"QMP {name}: {resp['error'].get('desc')}")
            return resp.get("return")

    def close(self) -> None:
        self.sock.close()


def qmp() -> QMP:
    if not is_running():
        die("simulator is not running (mobsim start)")
    return QMP(QMP_SOCK)


# --- lifecycle ----------------------------------------------------------------


def is_running() -> bool:
    try:
        pid = int(PIDFILE.read_text())
        os.kill(pid, 0)
        return True
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        return False


def hypr_device_conf(dev: dict) -> str:
    disp = main_display(dev)
    return (
        "# Generated by mobsim from devices/sim-x86_64/device.toml\n"
        f"monitor = , {disp['width']}x{disp['height']}, 0x0, {disp['scale']}\n"
    )


def user_data(pubkey: str, dev: dict) -> str:
    disp = main_display(dev)
    hypr_conf = (REPO / "os" / "config" / "hypr" / "hyprland.conf").read_text()
    device_conf = hypr_device_conf(dev)

    def indent(s: str) -> str:
        return "\n".join("      " + line for line in s.splitlines())

    return f"""#cloud-config
hostname: mobarchy-sim
users:
  - name: {GUEST_USER}
    gecos: Mobarchy
    groups: [wheel, video, input]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - {pubkey}
growpart:
  mode: auto
  devices: ["/"]
write_files:
  - path: /etc/systemd/system/getty@tty1.service.d/autologin.conf
    content: |
      [Service]
      ExecStart=
      ExecStart=-/sbin/agetty -o '-p -f -- \\\\u' --noclear --autologin {GUEST_USER} %I $TERM
  - path: /home/{GUEST_USER}/.config/hypr/hyprland.conf
    defer: true
    owner: {GUEST_USER}:{GUEST_USER}
    content: |
{indent(hypr_conf)}
  - path: /home/{GUEST_USER}/.config/hypr/device.conf
    defer: true
    owner: {GUEST_USER}:{GUEST_USER}
    content: |
{indent(device_conf)}
  - path: /home/{GUEST_USER}/.bash_profile
    defer: true
    owner: {GUEST_USER}:{GUEST_USER}
    content: |
      [ -f ~/.bashrc ] && . ~/.bashrc
      if [ "$(tty)" = /dev/tty1 ] && [ -f /var/lib/mobarchy/provisioned ]; then
        exec start-hyprland > ~/.hyprland.log 2>&1
      fi
runcmd:
  - [bash, -c, "pacman-key --init && pacman-key --populate archlinux"]
  - [pacman, -Syu, --noconfirm, --needed, hyprland, foot, mesa, grim, wtype, jq, python, uv, rsync, ttf-dejavu, noto-fonts]
  - [chown, -R, "{GUEST_USER}:{GUEST_USER}", /home/{GUEST_USER}]
  - [mkdir, -p, /var/lib/mobarchy]
  - [touch, /var/lib/mobarchy/provisioned]
  - [sync]
# Reboot into the upgraded kernel (its modules, e.g. uinput, are not loadable until then).
power_state:
  mode: reboot
  condition: true
"""


def cmd_create(args) -> None:
    if is_running():
        die("simulator is running; stop it first")
    STATE.mkdir(parents=True, exist_ok=True)
    dev = load_device()
    if not BASE_IMAGE.exists():
        print(f"downloading base image to {BASE_IMAGE}")
        subprocess.run(["curl", "-fL", "-o", str(BASE_IMAGE), BASE_IMAGE_URL], check=True)
    if DISK.exists() and not args.force:
        die(f"{DISK} exists (use --force to recreate)")
    for p in (DISK, SEED, OVMF_VARS):
        p.unlink(missing_ok=True)
    if not SSH_KEY.exists():
        subprocess.run(
            ["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "mobsim", "-f", str(SSH_KEY)],
            check=True,
        )
    size = dev["qemu"]["disk_size"]
    subprocess.run(
        ["qemu-img", "create", "-q", "-f", "qcow2", "-F", "qcow2", "-b", str(BASE_IMAGE), str(DISK), size],
        check=True,
    )
    shutil.copy(OVMF_VARS_TEMPLATE, OVMF_VARS)
    pubkey = SSH_KEY.with_suffix(".pub").read_text().strip()
    with tempfile.TemporaryDirectory() as tmp:
        t = Path(tmp)
        (t / "user-data").write_text(user_data(pubkey, dev))
        (t / "meta-data").write_text("instance-id: mobarchy-sim\nlocal-hostname: mobarchy-sim\n")
        subprocess.run(
            ["xorriso", "-as", "mkisofs", "-quiet", "-o", str(SEED), "-V", "cidata", "-J", "-r",
             str(t / "user-data"), str(t / "meta-data")],
            check=True,
        )
    print(f"created {DISK}. Run 'mobsim start'. The first boot provisions the guest (a few minutes).")


def cmd_start(args) -> None:
    if is_running():
        print("already running")
        return
    if not DISK.exists():
        die("no disk; run 'mobsim create' first")
    dev = load_device()
    q = dev["qemu"]
    disp = main_display(dev)
    QMP_SOCK.unlink(missing_ok=True)
    cmd = [
        "qemu-system-x86_64",
        "-name", "mobarchy-sim",
        "-machine", "q35,accel=kvm,vmport=off",
        "-cpu", "host",
        "-smp", str(q["cpus"]),
        "-m", q["memory"],
        "-drive", f"if=pflash,format=raw,readonly=on,file={OVMF_CODE}",
        "-drive", f"if=pflash,format=raw,file={OVMF_VARS}",
        "-drive", f"if=virtio,format=qcow2,file={DISK}",
        "-drive", f"if=virtio,format=raw,readonly=on,file={SEED}",
        "-netdev", f"user,id=net0,hostfwd=tcp:127.0.0.1:{q['ssh_port']}-:22"
                  f",hostfwd=tcp:127.0.0.1:{q['mcp_port']}-:8765",
        "-device", "virtio-net-pci,netdev=net0",
        "-device", f"virtio-vga,xres={disp['width']},yres={disp['height']}",
        "-device", "virtio-multitouch-pci",
        "-device", "virtio-keyboard-pci",
        "-serial", f"file:{SERIAL_LOG}",
        "-qmp", f"unix:{QMP_SOCK},server=on,wait=off",
        "-pidfile", str(PIDFILE),
        "-daemonize",
    ]
    cmd += ["-display", "gtk" if args.gui else "none"]
    # No core dumps: a QEMU core is several GB, and they pile up fast during development.
    subprocess.run(cmd, check=True, preexec_fn=lambda: resource.setrlimit(resource.RLIMIT_CORE, (0, 0)))
    print(f"started (pid {PIDFILE.read_text().strip()}); ssh on 127.0.0.1:{q['ssh_port']}")


def cmd_stop(args) -> None:
    if not is_running():
        print("not running")
        return
    pid = int(PIDFILE.read_text())
    if args.force:
        os.kill(pid, signal.SIGTERM)
    else:
        q = QMP(QMP_SOCK)
        q.cmd("system_powerdown")
        q.close()
    for _ in range(60):
        if not is_running():
            print("stopped")
            return
        time.sleep(1)
    die("guest did not shut down within 60s (try --force)")


def cmd_status(args) -> None:
    running = is_running()
    out = {"running": running, "state_dir": str(STATE)}
    if running:
        q = qmp()
        out["vm"] = q.cmd("query-status")["status"]
        q.close()
        try:
            r = ssh(["test -f /var/lib/mobarchy/provisioned && pgrep -x Hyprland >/dev/null; echo $?"],
                    capture=True, check=False, timeout=10)
            out["ssh"] = r.returncode == 0
            out["provisioned_and_shell_up"] = r.stdout.strip() == "0"
        except subprocess.TimeoutExpired:
            out["ssh"] = out["provisioned_and_shell_up"] = False
    print(json.dumps(out, indent=2))


# --- guest access -------------------------------------------------------------


def ssh_base() -> list[str]:
    port = load_device()["qemu"]["ssh_port"]
    return [
        "ssh", "-i", str(SSH_KEY), "-p", str(port),
        "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
        "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=5",
        f"{GUEST_USER}@127.0.0.1",
    ]


def ssh(command: list[str], capture=False, check=True, timeout=None) -> subprocess.CompletedProcess:
    return subprocess.run(ssh_base() + command, capture_output=capture, text=True, check=check, timeout=timeout)


WAYLAND_ENV = "export XDG_RUNTIME_DIR=/run/user/$(id -u) WAYLAND_DISPLAY=wayland-1;"


def cmd_ssh(args) -> None:
    os.execvp("ssh", ssh_base() + args.command)


def cmd_hyprctl(args) -> None:
    r = ssh([WAYLAND_ENV + " hyprctl -i 0 " + " ".join(map(sh_quote, args.args))], check=False)
    sys.exit(r.returncode)


def cmd_type(args) -> None:
    r = ssh([WAYLAND_ENV + " wtype " + sh_quote(args.text)], check=False)
    sys.exit(r.returncode)


def cmd_wait(args) -> None:
    """Block until the guest is provisioned and Hyprland is running."""
    deadline = time.time() + args.timeout
    while time.time() < deadline:
        if is_running():
            try:
                r = ssh(["test -f /var/lib/mobarchy/provisioned && pgrep -x Hyprland >/dev/null"],
                        capture=True, check=False, timeout=15)
            except subprocess.TimeoutExpired:
                continue  # sshd not up yet, or the guest is rebooting
            if r.returncode == 0:
                print("ready")
                return
        time.sleep(5)
    die(f"not ready after {args.timeout}s (see mobsim log)")


def rsync(src: str, dest: str, *extra: str, sudo: bool = False) -> None:
    """Copy host src to guest dest over the simulator's ssh (rsync semantics for trailing slashes)."""
    cmd = ["rsync", "-rlpt", "-e", " ".join(ssh_base()[:-1]), *extra]
    if sudo:
        cmd += ["--rsync-path", "sudo rsync"]
    subprocess.run(cmd + [src, f"{GUEST_USER}@127.0.0.1:{dest}"], check=True)


def cmd_sync(args) -> None:
    """Deploy the working tree into the guest: rootfs overlays, user config, and the agent layer."""
    dev_dir = DEVICE.parent
    # System files: generic overlay first, then the device overlay on top.
    rsync(f"{REPO}/os/rootfs/", "/", sudo=True)
    if (dev_dir / "rootfs").is_dir():
        rsync(f"{dev_dir}/rootfs/", "/", sudo=True)
    rsync(str(DEVICE), "/etc/mobarchy/device.toml", sudo=True)
    # Session config.
    rsync(f"{REPO}/os/config/", ".config/")
    with tempfile.NamedTemporaryFile("w", suffix=".conf") as f:
        f.write(hypr_device_conf(load_device()))
        f.flush()
        os.chmod(f.name, 0o644)
        rsync(f.name, ".config/hypr/device.conf")
    # Agent layer.
    ssh(["sudo install -d -o $(id -u) -g $(id -g) /opt/mobarchy/agent"])
    rsync(f"{REPO}/agent/", "/opt/mobarchy/agent/", "--delete-after",
          "--exclude", ".venv", "--exclude", "__pycache__", "--exclude", ".pytest_cache")
    ssh(["set -e; cd /opt/mobarchy/agent/mobarchy-mcp && uv sync -q --no-dev"])
    # Activate: uinput access, units, compositor config, MCP server.
    ssh(["set -e; sudo udevadm control --reload; sudo modprobe uinput; sudo udevadm trigger -s misc;"
         " systemctl --user daemon-reload;"
         " if pgrep -x Hyprland >/dev/null; then " + WAYLAND_ENV +
         " hyprctl -i 0 reload >/dev/null;"
         " export HYPRLAND_INSTANCE_SIGNATURE=$(hyprctl -i 0 -j instances | jq -r '.[0].instance');"
         " systemctl --user import-environment WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE;"
         " systemctl --user restart mobarchy-mcp;"
         " for i in $(seq 50); do curl -s -o /dev/null localhost:8765/mcp && break; sleep 0.2; done; fi"])
    print("synced")


def cmd_up(args) -> None:
    """Start (if needed), wait for the shell, and deploy the working tree."""
    cmd_start(argparse.Namespace(gui=args.gui))
    cmd_wait(argparse.Namespace(timeout=args.timeout))
    cmd_sync(args)


def cmd_log(args) -> None:
    lines = SERIAL_LOG.read_text(errors="replace").splitlines() if SERIAL_LOG.exists() else []
    print("\n".join(lines[-args.lines:]))


def sh_quote(s: str) -> str:
    return "'" + s.replace("'", "'\\''") + "'"


# --- host-side observation and input (ground truth, independent of the guest) --


def cmd_screenshot(args) -> None:
    out = Path(args.output).resolve()
    q = qmp()
    q.cmd("screendump", filename=str(out), format="png")
    q.close()
    print(out)


def to_abs(x: int, y: int) -> tuple[int, int]:
    """Map physical display pixels to QEMU's absolute axis range."""
    d = main_display(load_device())
    return round(x * ABS_MAX / (d["width"] - 1)), round(y * ABS_MAX / (d["height"] - 1))


def new_tracking_id() -> int:
    # Every contact needs a fresh id. The kernel drops ABS events whose value
    # has not changed, so a reused id would never register as a new touch.
    return int(time.monotonic() * 1000) % 0xFFFF


def touch_events(phase: str, x: int, y: int, tid: int, slot: int = 0) -> list[dict]:
    """Multitouch protocol B: begin/end write SLOT+TRACKING_ID, data writes a position."""
    def mtt(kind: str, tracking_id: int, axis: str = "x", value: int = 0) -> dict:
        return {"type": "mtt", "data": {"type": kind, "slot": slot, "tracking-id": tracking_id,
                                        "axis": axis, "value": value}}

    if phase == "up":
        return [mtt("end", -1)]
    ax, ay = to_abs(x, y)
    ev = [mtt("begin", tid)] if phase == "down" else []
    return ev + [mtt("data", tid, "x", ax), mtt("data", tid, "y", ay)]


def send_touch(q: QMP, phase: str, x: int, y: int, tid: int) -> None:
    # No 'device' argument: it names a display console, not an input device.
    # virtio-multitouch is the only handler for mtt events, so they reach it anyway.
    q.cmd("input-send-event", events=touch_events(phase, x, y, tid))


def cmd_tap(args) -> None:
    q = qmp()
    tid = new_tracking_id()
    send_touch(q, "down", args.x, args.y, tid)
    time.sleep(args.hold / 1000)
    send_touch(q, "up", args.x, args.y, tid)
    q.close()


def cmd_swipe(args) -> None:
    q = qmp()
    tid = new_tracking_id()
    steps = max(2, args.duration // 16)
    send_touch(q, "down", args.x1, args.y1, tid)
    for i in range(1, steps + 1):
        t = i / steps
        x = round(args.x1 + (args.x2 - args.x1) * t)
        y = round(args.y1 + (args.y2 - args.y1) * t)
        time.sleep(args.duration / 1000 / steps)
        send_touch(q, "move", x, y, tid)
    send_touch(q, "up", args.x2, args.y2, tid)
    q.close()


def cmd_key(args) -> None:
    """Press a key combination by QEMU qcode, e.g. 'meta_l-ret' or 'esc'."""
    q = qmp()
    q.cmd("send-key", keys=[{"type": "qcode", "data": k} for k in args.combo.split("-")])
    q.close()


# --- CLI ------------------------------------------------------------------------


def main() -> None:
    p = argparse.ArgumentParser(prog="mobsim", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("create", help="create the VM disk and cloud-init seed")
    s.add_argument("--force", action="store_true", help="recreate an existing disk")
    s.set_defaults(func=cmd_create)

    s = sub.add_parser("start", help="boot the VM (headless by default)")
    s.add_argument("--gui", action="store_true", help="open a QEMU window")
    s.set_defaults(func=cmd_start)

    s = sub.add_parser("stop", help="shut down the VM")
    s.add_argument("--force", action="store_true", help="kill instead of ACPI powerdown")
    s.set_defaults(func=cmd_stop)

    sub.add_parser("status", help="print VM status as JSON").set_defaults(func=cmd_status)

    s = sub.add_parser("wait", help="wait until the guest shell is up")
    s.add_argument("--timeout", type=int, default=900)
    s.set_defaults(func=cmd_wait)

    sub.add_parser("sync", help="deploy rootfs overlays, config and agent layer into the guest") \
        .set_defaults(func=cmd_sync)

    s = sub.add_parser("up", help="start + wait + sync")
    s.add_argument("--gui", action="store_true")
    s.add_argument("--timeout", type=int, default=900)
    s.set_defaults(func=cmd_up)

    s = sub.add_parser("log", help="show the serial console log")
    s.add_argument("-n", "--lines", type=int, default=50)
    s.set_defaults(func=cmd_log)

    s = sub.add_parser("ssh", help="ssh into the guest (optionally run a command)")
    s.add_argument("command", nargs=argparse.REMAINDER)
    s.set_defaults(func=cmd_ssh)

    s = sub.add_parser("hyprctl", help="run hyprctl in the guest session")
    s.add_argument("args", nargs=argparse.REMAINDER)
    s.set_defaults(func=cmd_hyprctl)

    s = sub.add_parser("type", help="type text into the focused window")
    s.add_argument("text")
    s.set_defaults(func=cmd_type)

    s = sub.add_parser("screenshot", help="capture the display from the host side (PNG)")
    s.add_argument("output", nargs="?", default="screenshot.png")
    s.set_defaults(func=cmd_screenshot)

    s = sub.add_parser("tap", help="tap at display pixel coordinates")
    s.add_argument("x", type=int)
    s.add_argument("y", type=int)
    s.add_argument("--hold", type=int, default=50, help="milliseconds")
    s.set_defaults(func=cmd_tap)

    s = sub.add_parser("swipe", help="swipe between two points")
    for a in ("x1", "y1", "x2", "y2"):
        s.add_argument(a, type=int)
    s.add_argument("--duration", type=int, default=300, help="milliseconds")
    s.set_defaults(func=cmd_swipe)

    s = sub.add_parser("key", help="press a key combo by QEMU qcode (e.g. meta_l-ret)")
    s.add_argument("combo")
    s.set_defaults(func=cmd_key)

    # ssh and hyprctl forward everything after the subcommand verbatim, flags included.
    argv = sys.argv[1:]
    if argv and argv[0] in ("ssh", "hyprctl"):
        args = argparse.Namespace(command=argv[1:], args=argv[1:])
        {"ssh": cmd_ssh, "hyprctl": cmd_hyprctl}[argv[0]](args)
        return
    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
