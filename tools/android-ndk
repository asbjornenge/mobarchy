#!/usr/bin/env bash
# Fetch the Android NDK that Mobarchy's Android-side code is built with (the Android
# container's programs and Mesa for it): r30, from Google, checked against the SHA-1 in
# Google's SDK repository (repository2-3.xml, ndk;30.0.16248370).
#
#   tools/android-ndk          installs it to ~/.cache/mobarchy/android-ndk-r30 (or $NDK)
set -euo pipefail
version=r30
sha1=5107f898313790e449e87eee2183d9a20602dee9
url=https://dl.google.com/android/repository/android-ndk-$version-linux.zip
ndk="${NDK:-$HOME/.cache/mobarchy/android-ndk-$version}"

if [ -x "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/clang" ]; then
    echo "$ndk"
    exit 0
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fL --progress-bar -o "$tmp/ndk.zip" "$url"
echo "$sha1  $tmp/ndk.zip" | sha1sum -c --quiet
mkdir -p "$(dirname "$ndk")"
unzip -q "$tmp/ndk.zip" -d "$tmp"
mv "$tmp/android-ndk-$version" "$ndk"
echo "$ndk"
