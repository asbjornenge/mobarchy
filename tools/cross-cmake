#!/usr/bin/env bash
# Cross-compile one of Mobarchy's own CMake packages (os/shell, os/browser, ...) for aarch64
# on this PC, and package it with its PKGBUILD. Minutes, where tools/pkg-build's container
# under qemu-user takes a quarter of an hour (and building on the phone heats it up).
#
#   tools/cross-cmake <package dir> --work <dir> [--repo <dir>] [--fresh]
#
#   --work   where the sysroot and the build tree go (a few GB)
#   --repo   Mobarchy's repository: the package is added to it (tools/repo-build --add)
#   --fresh  make the sysroot again (it is kept, and made again when the package's
#            dependencies change)
#
# As os/packages/qt6-webengine/cross-build does it (Qt's cross-compiling): an Arch Linux ARM
# sysroot with the package's dependencies (the mobarchy-alarm-base container, exported); an
# Arch Linux x86_64 container with the same Qt for the host tools (moc, rcc, qmlcachegen,
# qtwaylandscanner) and clang/lld; CMake with Qt's toolchain file, chained to one for clang
# targeting aarch64. Then the PKGBUILD's package() in the aarch64 container, on that build
# tree (makepkg -R).
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
pkgdir="" work="" repo="" fresh=0
while [ $# -gt 0 ]; do
    case "$1" in
        --work) work="$(realpath -m "$2")"; shift 2 ;;
        --repo) repo="$(realpath -m "$2")"; shift 2 ;;
        --fresh) fresh=1; shift ;;
        -*) echo "unknown argument: $1" >&2; exit 2 ;;
        *) pkgdir="$(realpath "$1")"; shift ;;
    esac
done
[ -n "$pkgdir" ] && [ -n "$work" ] && [ -f "$pkgdir/PKGBUILD" ] || {
    echo "usage: $0 <package dir> --work <dir> [--repo <dir>] [--fresh]" >&2; exit 2; }
pkgvar() { bash -c "source '$pkgdir/PKGBUILD'; $1"; }
name=$(pkgvar 'echo $pkgname') version=$(pkgvar 'echo $pkgver-$pkgrel')
deps=$(pkgvar 'printf "%s\n" "${depends[@]}" "${makedepends[@]}"' | grep -vxE 'cmake|ninja' | sort | tr '\n' ' ')
work=$work/$name
sysroot=$work/sysroot build=$work/build out=$work/out
mkdir -p "$work"
alarm_image=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep -m1 '^mobarchy-alarm-base:') || {
    echo "no mobarchy-alarm-base image: run os/image/build once" >&2; exit 1; }
t0=$(date +%s)
say() { echo "== $* ($(( $(date +%s) - t0 )) s)"; }

# --- the target's root: the package's dependencies for aarch64 ---------------------------
if [ $fresh = 1 ] || [ "$(cat "$work/sysroot.deps" 2>/dev/null)" != "$deps" ] || [ ! -d "$sysroot/usr" ]; then
    say "sysroot: $deps"
    docker rm -f "$name-sysroot" >/dev/null 2>&1 || true
    docker run --name "$name-sysroot" --platform linux/arm64 "$alarm_image" bash -c "
        pacman-key --init >/dev/null 2>&1 && pacman-key --populate archlinuxarm >/dev/null 2>&1
        for i in 1 2 3; do
            pacman -Syu --noconfirm --needed --disable-sandbox gcc pkgconf linux-api-headers $deps >/tmp/p.log 2>&1 && exit 0
            sleep 30
        done
        tail -20 /tmp/p.log; exit 1"
    [ ! -d "$sysroot" ] || { chmod -R u+w "$sysroot" && rm -rf "$sysroot"; }
    mkdir -p "$sysroot"
    docker export "$name-sysroot" | tar -x -C "$sysroot" --anchored --exclude='dev/*' --exclude='proc/*' \
        --exclude='sys/*' --exclude='var/cache/pacman/pkg/*' 2>/dev/null || true
    docker rm "$name-sysroot" >/dev/null
    echo "$deps" > "$work/sysroot.deps"
    rm -rf "$build"
fi
target_qt=$(grep -m1 -A1 '^%VERSION%' "$sysroot"/var/lib/pacman/local/qt6-base-*/desc | tail -1)

# --- the host: the same Qt for its tools, and clang -------------------------------------
# Arch Linux x86_64 as it was while it had the target's Qt (Arch Linux ARM follows Arch
# later): the Arch Linux Archive's repositories of the day before Arch's next qt6-base.
snapshot_for() {
    curl -fsSL https://archive.archlinux.org/packages/q/qt6-base/ | python3 -c '
import re, sys, datetime
target = sys.argv[1]
rows = re.findall(r"qt6-base-([0-9][^\"]*?)-x86_64\.pkg\.tar\.zst\"[^<]*</a>\s+(\d\d-\w{3}-\d{4})", sys.stdin.read())
rows = [(v, datetime.datetime.strptime(d, "%d-%b-%Y").date()) for v, d in rows]
i = next(i for i, (v, _) in enumerate(rows) if v == target)
day = rows[i + 1][1] - datetime.timedelta(days=1) if i + 1 < len(rows) else datetime.date.today()
print(day.strftime("%Y/%m/%d"))' "$1"
}
host_image=mobarchy-cross-host:qt-$target_qt
if ! docker image inspect "$host_image" >/dev/null 2>&1; then
    snapshot=$(snapshot_for "$target_qt")
    say "host image (Qt $target_qt, Arch of $snapshot)"
    docker build -q -t "$host_image" - <<DOCKERFILE >/dev/null
FROM archlinux:latest
RUN echo 'Server = https://archive.archlinux.org/repos/$snapshot/\$repo/os/\$arch' > /etc/pacman.d/mirrorlist \
    && pacman -Syyuu --noconfirm \
    && pacman -S --noconfirm --needed base-devel clang lld llvm cmake ninja pkgconf wayland \
      qt6-base qt6-declarative qt6-shadertools qt6-wayland qt6-tools \
    && pacman -Scc --noconfirm
DOCKERFILE
    host_qt=$(docker run --rm "$host_image" pacman -Q qt6-base | awk '{print $2}')
    [ "$host_qt" = "$target_qt" ] || { docker rmi "$host_image" >/dev/null
        echo "host Qt $host_qt, target Qt $target_qt: not the same version" >&2; exit 1; }
fi

in_host() {
    docker run --rm -u "$(id -u):$(id -g)" -v "$work:$work" -v "$pkgdir:$pkgdir:ro" -w "$work" \
        "$host_image" bash -euo pipefail -c "$1"
}

# --- configure and build ----------------------------------------------------------------
cat > "$work/aarch64.cmake" <<EOF
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_SYSROOT $sysroot)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET aarch64-unknown-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-unknown-linux-gnu)
set(CMAKE_AR llvm-ar)
set(CMAKE_RANLIB llvm-ranlib)
set(CMAKE_EXE_LINKER_FLAGS_INIT -fuse-ld=lld)
set(CMAKE_SHARED_LINKER_FLAGS_INIT -fuse-ld=lld)
set(CMAKE_MODULE_LINKER_FLAGS_INIT -fuse-ld=lld)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_SYSROOT_DIR} $sysroot)
set(ENV{PKG_CONFIG_LIBDIR} $sysroot/usr/lib/pkgconfig:$sysroot/usr/share/pkgconfig)
EOF
say "configure and build $name $version"
in_host "cmake -S '$pkgdir' -B '$build' -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_TOOLCHAIN_FILE='$sysroot/usr/lib/cmake/Qt6/qt.toolchain.cmake' \
    -DQT_CHAINLOAD_TOOLCHAIN_FILE='$work/aarch64.cmake' -DQT_HOST_PATH=/usr >'$work/configure.log' 2>&1 \
    || { tail -30 '$work/configure.log'; exit 1; }
    nice -n 10 cmake --build '$build' >'$work/build.log' 2>&1 || { grep -E 'error|Error' -m 20 '$work/build.log'; exit 1; }"

# --- package: the PKGBUILD's package() on that tree -------------------------------------
say "package"
mkdir -p "$out" "$work/makepkg/$name/src"
ln -sfn "$build" "$work/makepkg/$name/src/build"
docker run --rm --platform linux/arm64 -v "$work:$work" -v "$pkgdir:/pkg:ro" -v "$pkgdir:$pkgdir:ro" "$alarm_image" bash -euo pipefail -c "
    pacman-key --init >/dev/null 2>&1 && pacman-key --populate archlinuxarm >/dev/null 2>&1
    pacman -Sy --noconfirm --needed --disable-sandbox cmake fakeroot binutils >/dev/null
    useradd -m -o -u $(id -u) builder && cp -r /pkg /tmp/pkg && chown -R builder /tmp/pkg $out $work/makepkg
    su builder -c 'cd /tmp/pkg && BUILDDIR=$work/makepkg SRCDEST=/tmp/pkg PKGDEST=$out PKGEXT=.pkg.tar.zst \
        makepkg -R -d -f --noconfirm' >$work/package.log 2>&1 \
        || { tail -20 $work/package.log; exit 1; }"
pkg=$out/$name-$version-aarch64.pkg.tar.zst
ls -la "$pkg"
[ -z "$repo" ] || "$repo_root/tools/repo-build" --repo "$repo" --add "$pkg"
say "done"
