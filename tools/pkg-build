#!/usr/bin/env bash
# Build one of Mobarchy's Arch packages for aarch64, in the Arch Linux ARM container
# (qemu-user), with makepkg.
#
#   tools/pkg-build <name> --out <dir>        os/packages/<name>/PKGBUILD
#   tools/pkg-build <dir> --out <dir>         any directory with a PKGBUILD (e.g. os/shell)
#
# os/packages holds distribution packages Mobarchy patches (fixes not yet upstream), as
# the distribution's PKGBUILD plus patches with a higher pkgrel, and third-party packages
# Arch doesn't have (e.g. mobile-config-firefox). Mobarchy's own software
# keeps its PKGBUILD next to its source. Install the result on the device with pacman -U,
# or put it in the image (os/image/build --extra packages=<dir>).
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
name="${1:-}"; shift || true
out=""
while [ $# -gt 0 ]; do
    case "$1" in
        --out) out="$(realpath -m "$2")"; shift 2 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done
if [ -n "$name" ] && [ -f "$name/PKGBUILD" ]; then
    pkgdir="$(realpath "$name")"
else
    pkgdir="$repo/os/packages/$name"
fi
[ -n "$name" ] && [ -n "$out" ] && [ -f "$pkgdir/PKGBUILD" ] || {
    echo "usage: $0 <name>|<dir> --out <dir>   (with os/packages/<name>/PKGBUILD or <dir>/PKGBUILD)" >&2; exit 2; }
name=$(bash -c 'source "$1/PKGBUILD" && echo "$pkgname"' _ "$pkgdir")
mkdir -p "$out"
image=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep -m1 '^mobarchy-alarm-base:') || {
    echo "no mobarchy-alarm-base image: run os/image/build once" >&2; exit 1; }

# Bounded: compilers under qemu-user use several times their native memory, and an
# unbounded build ran the host out of memory (the OOM killer took the owner's browser).
# Ninja (os/shell) reads no MAKEFLAGS: CMAKE_BUILD_PARALLEL_LEVEL bounds cmake --build.
docker run --rm --platform linux/arm64 --memory 20g --cpus 8 -e MAKEFLAGS=-j6 -e CMAKE_BUILD_PARALLEL_LEVEL=6 \
    -v "$pkgdir:/pkg:ro" -v "$out:/out" "$image" bash -euo pipefail -c '
    pacman-key --init >/dev/null 2>&1 && pacman-key --populate archlinuxarm >/dev/null 2>&1
    pacman -Syu --noconfirm --needed --disable-sandbox base-devel >/dev/null
    # Dependencies are installed here, as root: makepkg --syncdeps would need sudo, and
    # setuid does not work under qemu-user.
    deps=$(bash -c "source /pkg/PKGBUILD; printf \"%s\n\" \"\${depends[@]}\" \"\${makedepends[@]}\" \"\${checkdepends[@]}\"")
    pacman -S --noconfirm --needed --disable-sandbox $deps >/dev/null
    useradd -m builder
    cp -r /pkg /tmp/build && chown -R builder /tmp/build
    su builder -c "cd /tmp/build && PKGDEST=/tmp/build/out BUILDDIR=/tmp/makepkg PKGEXT=.pkg.tar.zst makepkg --noconfirm" \
        > /tmp/makepkg.log 2>&1 || { cp /tmp/makepkg.log /out/makepkg-'"$name"'.log; tail -30 /tmp/makepkg.log >&2; exit 1; }
    cp /tmp/makepkg.log /out/makepkg-'"$name"'.log && cp /tmp/build/out/*.pkg.tar.zst /out/
    chmod a+r /out/*
'
ls "$out"/"$name"-*.pkg.tar.zst
