#!/usr/bin/env bash
# Build Mobarchy's packages into its pacman repository (a directory with mobarchy.db):
# Mobarchy's own software (os/shell, agent) and the packages in os/packages.
#
#   tools/repo-build --repo <dir> [--builder container|device] [--add <pkg file>]... [what...]
#
#   what       os/shell, agent, os/store, os/android-services, os/android-sensors,
#              os/android-fingerprint, os/camera,
#              or a name in os/packages (default: all of them)
#   --builder  container: the Arch Linux ARM container under qemu-user (tools/pkg-build);
#              slow for big C/C++ builds.
#              device: on a connected device over ssh (MOBARCHY_DEVICE, default
#              mob@172.16.42.1, key ~/.config/mobarchy/device_ed25519), natively. Build
#              dependencies get installed there.
#   --add      a package built elsewhere (e.g. os/mesa/build's mesa-mobarchy)
#
# Parts that run in the Android container are built here first, with the Android NDK
# (tools/android-ndk): a package directory whose Makefile has an "ndk" target gets
# "make ndk" on the host; its PKGBUILD then packages the result.
#
# os/image/build installs from this repository (--repo). Unsigned for now.
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
repo="" builder=container adds=() what=()
while [ $# -gt 0 ]; do
    case "$1" in
        --repo) repo="$(realpath -m "$2")"; shift 2 ;;
        --builder) builder="$2"; shift 2 ;;
        --add) adds+=("$(realpath "$2")"); shift 2 ;;
        -*) echo "unknown argument: $1" >&2; exit 2 ;;
        *) what+=("$1"); shift ;;
    esac
done
[ -n "$repo" ] || { echo "usage: $0 --repo <dir> [--builder container|device] [--add <pkg>]... [what...]" >&2; exit 2; }
[ ${#what[@]} -gt 0 ] || what=(os/shell agent os/store os/android-services os/android-sensors os/android-fingerprint os/camera
                               $(cd "$repo_root/os/packages" && ls))
mkdir -p "$repo"

pkgdir_of() {  # name or path -> directory with the PKGBUILD
    if [ -f "$repo_root/$1/PKGBUILD" ]; then echo "$repo_root/$1"
    elif [ -f "$repo_root/os/packages/$1/PKGBUILD" ]; then echo "$repo_root/os/packages/$1"
    else echo "no PKGBUILD for $1" >&2; return 1; fi
}

device=${MOBARCHY_DEVICE:-mob@172.16.42.1}
ssh_opts=(-i "$HOME/.config/mobarchy/device_ed25519" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)
on_device() { ssh "${ssh_opts[@]}" "$device" "$@"; }

build_on_device() {  # <pkgdir>
    local dir=$1 name work=/var/tmp/mobarchy-build
    name=$(basename "$dir")
    on_device "mkdir -p $work/src $work/out && rm -f $work/out/*"
    rsync -a --delete --exclude .venv --exclude __pycache__ --exclude .pytest_cache --exclude build \
        -e "ssh ${ssh_opts[*]}" "$dir/" "$device:$work/src/$name/"
    on_device bash -euo pipefail -s -- "$work" "$name" <<'REMOTE'
work=$1 name=$2
cd "$work/src/$name"
deps=$(bash -c 'source PKGBUILD; printf "%s\n" "${depends[@]}" "${makedepends[@]}" "${checkdepends[@]}"' | sed 's/[<>=].*//' | sort -u)
# Only what is missing: dependencies built here earlier (e.g. libglibutil for libgbinder)
# are installed but not in any sync repository.
missing=$(pacman -T $deps || true)
[ -z "$missing" ] || sudo pacman -S --needed --noconfirm --disable-sandbox $missing >/dev/null
# A phone has no thermal management yet: a few jobs, or it gets hot enough to shut down.
export MAKEFLAGS=-j3 CMAKE_BUILD_PARALLEL_LEVEL=3
BUILDDIR=$work/makepkg/$name PKGDEST=$work/out PKGEXT=.pkg.tar.zst makepkg -fC --noconfirm \
    > "$work/makepkg-$name.log" 2>&1 || { tail -30 "$work/makepkg-$name.log" >&2; exit 1; }
REMOTE
    rsync -a -e "ssh ${ssh_opts[*]}" "$device:$work/out/" "$repo/"
}

for w in "${what[@]}"; do
    dir=$(pkgdir_of "$w")
    echo "== $w ($builder)"
    if grep -q '^ndk:' "$dir/Makefile" 2>/dev/null; then
        NDK=$("$repo_root/tools/android-ndk") make -C "$dir" ndk
    fi
    case $builder in
        container) "$repo_root/tools/pkg-build" "$dir" --out "$repo" ;;
        device) build_on_device "$dir" ;;
        *) echo "unknown builder: $builder" >&2; exit 2 ;;
    esac
done
for p in "${adds[@]}"; do cp "$p" "$repo/"; done

# The database: every package file in the directory, the newest version of each wins (-R
# removes the files of the versions it replaces). Made afresh each time: a package rebuilt
# with the same version kept its old checksum in an updated database.
rm -f "$repo"/mobarchy.db* "$repo"/mobarchy.files*
image=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep -m1 '^mobarchy-alarm-base:') || {
    echo "no mobarchy-alarm-base image: run os/image/build once" >&2; exit 1; }
docker run --rm --platform linux/arm64 -u "$(id -u):$(id -g)" -v "$repo:/repo" "$image" \
    bash -c 'cd /repo && repo-add -q -R -n mobarchy.db.tar.zst *.pkg.tar.zst'
ls "$repo"
