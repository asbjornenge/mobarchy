#!/usr/bin/env bash
# Publish Mobarchy's package repository (tools/repo-build's directory) to where phones get it:
# a directory on a web server, over ssh (rsync), given as MOBARCHY_REPO_DEST=host:/path; the
# phones' pacman.conf points at the URL that serves it.
#
#   MOBARCHY_REPO_DEST=host:/srv/mobarchy-repo tools/repo-publish --repo <dir>
#                                                  e.g. <T7>/mobarchy/repo/aarch64
#
# Only packages and the database go (not makepkg's logs); what was removed here goes there too.
set -euo pipefail
repo=""
while [ $# -gt 0 ]; do
    case "$1" in --repo) repo="$(realpath "$2")"; shift 2 ;; *) echo "unknown argument: $1" >&2; exit 2 ;; esac
done
[ -n "$repo" ] && [ -f "$repo/mobarchy.db" ] || { echo "usage: $0 --repo <dir with mobarchy.db>" >&2; exit 2; }
arch=$(basename "$repo")
dest=${MOBARCHY_REPO_DEST:?set MOBARCHY_REPO_DEST=host:/path (where the repository is served from)}
ssh "${dest%%:*}" "mkdir -p '${dest#*:}/$arch'"
rsync -a --delete --copy-links --include='*.pkg.tar.zst' --include='*.pkg.tar.zst.sig' \
    --include='mobarchy.db*' --include='mobarchy.files*' --exclude='*' "$repo/" "$dest/$arch/"
echo "published $(ls "$repo"/*.pkg.tar.zst | wc -l) packages to $dest/$arch"
